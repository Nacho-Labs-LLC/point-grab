{
  "name": "@pointgrab/mcp-server",
  "version": "0.1.0",
  "description": "MCP stdio + webhook server for pointgrab",
  "author": {
    "name": "Nate Richardson",
    "email": "hello@naterichardson.com",
    "url": "https://github.com/naterchrdsn"
  },
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nacho-Labs-LLC/point-grab.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://point-grab.com",
