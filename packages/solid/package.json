{
  "name": "@point-grab/solid",
  "version": "0.2.0",
  "description": "SolidJS adapter and Vite transform for point-grab",
  "author": {
    "name": "Nate Richardson",
    "email": "hello@nacholabs.net",
    "url": "https://github.com/naterchrdsn"
  },
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nacho-Labs-LLC/point-grab.git",
    "directory": "packages/solid"
  },
  "homepage": "https://point-grab.com",
  "bugs": "https://github.com/Nacho-Labs-LLC/point-grab/issues",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "point-grab",
    "solid",
    "solidjs",
    "vite",
    "element-picker",
    "developer-tools",
    "ai"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "@point-grab/core": "workspace:*",
    "solid-js": "^1.9.18",
    "vite": "^6.4.5 || ^7.3.7 || ^8.3.3"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": false
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@babel/core": "^8.1.2",
    "@babel/types": "^7.29.14"
  },
  "devDependencies": {
    "@point-grab/core": "workspace:*",
    "@types/babel__core": "^7.20.5",
    "jsdom": "^30.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
