{
  "name": "@point-grab/angular",
  "version": "0.1.3",
  "description": "Angular adapter for point-grab",
  "author": {
    "name": "Nate Richardson",
    "email": "hello@nacholabs.net",
    "url": "https://github.com/naterchrdsn"
  },
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nacho-Labs-LLC/point-grab.git",
    "directory": "packages/angular"
  },
  "homepage": "https://point-grab.com",
  "bugs": "https://github.com/Nacho-Labs-LLC/point-grab/issues",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "point-grab",
    "angular",
    "element-picker",
    "developer-tools",
    "ai"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "point-grab": "workspace:*",
    "@angular/core": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": false
    }
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}
