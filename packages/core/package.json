{
  "name": "@point-grab/core",
  "version": "0.1.4",
  "description": "Point at any element. Grab its full context. Send it to your AI agent.",
  "author": {
    "name": "Nate Richardson",
    "email": "hello@nacholabs.net",
    "url": "https://github.com/naterchrdsn"
  },
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nacho-Labs-LLC/point-grab.git",
    "directory": "packages/core"
  },
  "homepage": "https://point-grab.com",
  "bugs": "https://github.com/Nacho-Labs-LLC/point-grab/issues",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./global": {
      "default": "./dist/index.global.js"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "point-grab",
    "element-picker",
    "developer-tools",
    "ai",
    "mcp",
    "component-inspector"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "jsdom": "^29.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
