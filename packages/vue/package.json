{
  "name": "@pointgrab/vue",
  "version": "0.1.0",
  "description": "Vue adapter for pointgrab",
  "author": "Nate Richardson",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nacho-Labs-LLC/point-grab.git",
    "directory": "packages/vue"
  },
  "homepage": "https://point-grab.com",
  "bugs": "https://github.com/Nacho-Labs-LLC/point-grab/issues",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "keywords": ["pointgrab", "vue", "element-picker", "developer-tools", "ai"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "pointgrab": "workspace:*",
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": false
    }
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}
