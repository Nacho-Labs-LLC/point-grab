{
  "name": "@point-grab/react",
  "version": "0.1.4",
  "description": "React adapter for point-grab",
  "author": {
    "name": "Nate Richardson",
    "email": "hello@nacholabs.net",
    "url": "https://github.com/naterchrdsn"
  },
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nacho-Labs-LLC/point-grab.git",
    "directory": "packages/react"
  },
  "homepage": "https://point-grab.com",
  "bugs": "https://github.com/Nacho-Labs-LLC/point-grab/issues",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "point-grab",
    "react",
    "element-picker",
    "developer-tools",
    "ai"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "@point-grab/core": "workspace:*",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
