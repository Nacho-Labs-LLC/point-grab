{
  "name": "@point-grab/web-components",
  "version": "0.1.5",
  "description": "Web Components adapter for point-grab",
  "author": {
    "name": "Nate Richardson",
    "email": "hello@nacholabs.net",
    "url": "https://github.com/naterchrdsn"
  },
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nacho-Labs-LLC/point-grab.git",
    "directory": "packages/web-components"
  },
  "homepage": "https://point-grab.com",
  "bugs": "https://github.com/Nacho-Labs-LLC/point-grab/issues",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "point-grab",
    "web-components",
    "element-picker",
    "developer-tools",
    "ai"
