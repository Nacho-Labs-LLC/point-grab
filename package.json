  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c",
  "scripts": {
    "build": "PATH=\"$PWD/scripts/bin:$PATH\" corepack pnpm exec turbo run build",
    "dev": "PATH=\"$PWD/scripts/bin:$PATH\" corepack pnpm exec turbo run dev",
    "test": "PATH=\"$PWD/scripts/bin:$PATH\" corepack pnpm exec turbo run test",
    "test:e2e": "PATH=\"$PWD/scripts/bin:$PATH\" node scripts/test-e2e.mjs",
    "test:e2e:review": "PATH=\"$PWD/scripts/bin:$PATH\" node scripts/review-e2e.mjs",
    "test:e2e:ui": "playwright test --config=playwright.framework-matrix.config.ts --ui",
    "lint": "PATH=\"$PWD/scripts/bin:$PATH\" corepack pnpm exec turbo run lint",
    "clean": "PATH=\"$PWD/scripts/bin:$PATH\" corepack pnpm exec turbo run clean",
    "verify:release": "node scripts/verify-release-artifacts.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "turbo": "^2.11.13"
  },
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.0 <0.28.1": "^0.28.2"
    }
  }
