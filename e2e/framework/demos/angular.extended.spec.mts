/** Source-derived Relay branches omitted by angular.spec.mts. */
import { test, expect, openApp } from '../fixtures.mts';
import { checkpoint } from '../../checkpoint';
import type { Page } from '@playwright/test';

const column = (page: Page, status: string) => page.locator(`app-board-column section[data-status="${status}"]`);
const complete = () => test.info().annotations.push({ type: 'coverage', description: 'demo-complete' });

test.beforeEach(async ({ page, errors }) => { void errors; await openApp(page); });

test('new task: blank validation recovers with assignee and normalized label', async ({ page }) => {
  await page.getByRole('button', { name: '+ New task' }).click();
  const dialog = page.getByRole('dialog', { name: 'New task', exact: true });
  await expect(dialog).toBeVisible();
  await expect(dialog.getByLabel('Priority', { exact: true })).toHaveValue('medium');
  await checkpoint(page, 'angular-new-task-defaults');
  await dialog.getByRole('button', { name: 'Create task', exact: true }).click();
  await expect(dialog.getByRole('alert')).toHaveText('Give the task a title.');
  await expect(page.locator('app-task-card')).toHaveCount(5);
  await checkpoint(page, 'angular-new-task-blank-title-error');
  await dialog.getByLabel('New task title').fill('   ');
  await dialog.getByRole('button', { name: 'Create task', exact: true }).click();
  await expect(dialog.getByRole('alert')).toHaveText('Give the task a title.');
  await expect(dialog.getByLabel('New task title')).toHaveValue('   ');
  await checkpoint(page, 'angular-new-task-whitespace-title-error');
  await dialog.getByLabel('New task title').fill('  Receipt delivery  ');
  await dialog.getByLabel('Assignee', { exact: true }).selectOption({ label: 'Rosa Lin' });
  await dialog.getByLabel('Label', { exact: true }).fill('  RELEASE  ');
  await dialog.getByLabel('Priority', { exact: true }).selectOption('low');
  await expect(dialog.getByLabel('Assignee', { exact: true })).toHaveValue('2');
  await expect(dialog.getByLabel('Label', { exact: true })).toHaveValue('  RELEASE  ');
  await checkpoint(page, 'angular-new-task-assignee-label-configured');
  await dialog.getByRole('button', { name: 'Create task', exact: true }).click();
  await expect(dialog).toHaveCount(0);
  const card = column(page, 'todo').locator('app-task-card').filter({ hasText: 'Receipt delivery' });
  await expect(card.getByRole('button', { name: 'Open Receipt delivery', exact: true })).toBeVisible();
  await expect(card.locator('.label')).toHaveText('release');
  await expect(card.getByTitle('Rosa Lin', { exact: true })).toHaveText('RL');
  await expect(card.locator('article')).toHaveAttribute('data-priority', 'low');
  await expect(page.locator('app-task-card')).toHaveCount(6);
  await expect(column(page, 'todo').getByTestId('column-count')).toHaveText('3');
  const drawer = page.getByTestId('task-drawer');
  await expect(drawer).toContainText('Assigned to Rosa Lin');
  await expect(drawer.getByLabel('Task title')).toHaveValue('Receipt delivery');
  await expect(drawer.getByTestId('checklist-progress')).toHaveText('0%');
  await expect(drawer.getByRole('checkbox')).toHaveCount(0);
  await checkpoint(page, 'angular-created-task-assignee-label-empty-checklist');
  await drawer.getByRole('button', { name: 'Close task details' }).click();
  await page.getByLabel('Search tasks').fill('release');
  await expect(page.locator('app-task-card')).toHaveCount(1);
  await expect(card).toBeVisible();
  await checkpoint(page, 'angular-search-new-normalized-label');
  complete();
});

test('new task: Cancel and backdrop discard drafts without creating tasks', async ({ page }) => {
  const dialog = page.getByRole('dialog', { name: 'New task', exact: true });
  await page.getByRole('button', { name: '+ New task' }).click();
  await dialog.getByLabel('New task title').fill('Cancelled draft');
  await expect(dialog.getByLabel('New task title')).toHaveValue('Cancelled draft');
  await checkpoint(page, 'angular-cancel-draft-open');
  await dialog.getByRole('button', { name: 'Cancel', exact: true }).click();
  await expect(dialog).toHaveCount(0);
  await expect(page.locator('app-task-card')).toHaveCount(5);
  await expect(page.getByRole('button', { name: 'Open Cancelled draft', exact: true })).toHaveCount(0);
  await checkpoint(page, 'angular-cancel-draft-discarded');
  await page.getByRole('button', { name: '+ New task' }).click();
  await expect(dialog.getByLabel('New task title')).toHaveValue('');
  await expect(dialog.getByRole('alert')).toHaveCount(0);
  await dialog.getByLabel('New task title').fill('Backdrop draft');
  await expect(dialog.getByLabel('New task title')).toHaveValue('Backdrop draft');
  await checkpoint(page, 'angular-backdrop-draft-open');
  await page.locator('app-new-task-dialog .backdrop').click({ position: { x: 5, y: 5 } });
  await expect(dialog).toHaveCount(0);
  await expect(page.locator('app-task-card')).toHaveCount(5);
  await expect(page.getByRole('button', { name: 'Open Backdrop draft', exact: true })).toHaveCount(0);
  await checkpoint(page, 'angular-backdrop-draft-discarded');
  complete();
});

test('board: backward moves update both columns, drawer and sprint stats', async ({ page }) => {
  const title = 'Fix coupon field focus ring';
  await page.getByRole('button', { name: `Open ${title}`, exact: true }).click();
  const drawer = page.getByTestId('task-drawer');
  await expect(drawer.getByLabel('Task status')).toHaveValue('done');
  await expect(page.getByTestId('done-count')).toHaveText('1');
  await checkpoint(page, 'angular-backward-move-done-origin');
  await page.getByRole('button', { name: `Move ${title} to In progress`, exact: true }).click();
  await expect(column(page, 'doing').getByRole('button', { name: `Open ${title}`, exact: true })).toBeVisible();
  await expect(column(page, 'doing').getByTestId('column-count')).toHaveText('3');
  await expect(column(page, 'done').getByTestId('column-count')).toHaveText('0');
  await expect(column(page, 'done')).toContainText('Nothing here yet.');
  await expect(drawer.getByLabel('Task status')).toHaveValue('doing');
  await expect(page.getByTestId('done-count')).toHaveText('0');
  await expect(page.getByLabel('Sprint progress')).toContainText('0% complete');
  await checkpoint(page, 'angular-backward-done-to-doing');
  await page.getByRole('button', { name: `Move ${title} to To do`, exact: true }).click();
  const card = column(page, 'todo').locator('app-task-card').filter({ hasText: title });
  await expect(card).toBeVisible();
  await expect(column(page, 'todo').getByTestId('column-count')).toHaveText('3');
  await expect(column(page, 'doing').getByTestId('column-count')).toHaveText('2');
  await expect(drawer.getByLabel('Task status')).toHaveValue('todo');
  await expect(card.getByRole('button', { name: /^Move / })).toHaveCount(1);
  await expect(card.getByRole('button', { name: `Move ${title} to In progress`, exact: true })).toBeVisible();
  await checkpoint(page, 'angular-backward-doing-to-todo-boundary');
  complete();
});

test('board: combined empty filters recover via search clear and All', async ({ page }) => {
  const filters = page.getByRole('group', { name: 'Filter by priority' });
  await page.getByLabel('Search tasks').fill('no-such-relay-task');
  await expect(page.locator('app-task-card')).toHaveCount(0);
  await expect(page.getByText('Nothing here matches your filter.', { exact: true })).toHaveCount(3);
  await expect(page.getByTestId('column-count')).toHaveText(['0', '0', '0']);
  await expect(page.getByTestId('done-count')).toHaveText('1');
  await checkpoint(page, 'angular-empty-search-all-columns');
  await filters.getByRole('button', { name: 'high', exact: true }).click();
  await page.getByLabel('Search tasks').fill('payments');
  await expect(filters.getByRole('button', { name: 'high', exact: true })).toHaveAttribute('aria-pressed', 'true');
  await expect(page.locator('app-task-card')).toHaveCount(0);
  await checkpoint(page, 'angular-empty-combined-label-priority-filter');
  await filters.getByRole('button', { name: 'All', exact: true }).click();
  await expect(page.locator('app-task-card')).toHaveCount(1);
  await expect(page.getByRole('button', { name: 'Open Apple Pay on the payment step', exact: true })).toBeVisible();
  await checkpoint(page, 'angular-priority-reset-retains-label-search');
  await page.getByLabel('Search tasks').fill('');
  await expect(page.locator('app-task-card')).toHaveCount(5);
  await expect(page.getByTestId('column-count')).toHaveText(['2', '2', '1']);
  await expect(page.getByText('Nothing here matches your filter.', { exact: true })).toHaveCount(0);
  await checkpoint(page, 'angular-filter-controls-reset-board');
  complete();
});

test('checklist: uncheck and restore updates progress and card completion', async ({ page }) => {
  await page.getByRole('button', { name: 'Open Fix coupon field focus ring', exact: true }).click();
  const drawer = page.getByTestId('task-drawer');
  const check = drawer.getByRole('checkbox', { name: 'Contrast check' });
  const card = column(page, 'done').locator('app-task-card');
  await expect(check).toBeChecked();
  await expect(drawer.getByTestId('checklist-progress')).toHaveText('100%');
  await expect(card.locator('.progress')).toHaveClass(/complete/);
  await checkpoint(page, 'angular-checklist-complete-origin');
  await check.uncheck();
  await expect(check).not.toBeChecked();
  await expect(drawer.getByTestId('checklist-progress')).toHaveText('0%');
  await expect(card.locator('.progress')).toHaveText('✓ 0/1');
  await expect(card.locator('.progress')).not.toHaveClass(/complete/);
  await expect(page.getByTestId('done-count')).toHaveText('1');
  await checkpoint(page, 'angular-checklist-reversed-not-task-status');
  await check.check();
  await expect(check).toBeChecked();
  await expect(drawer.getByTestId('checklist-progress')).toHaveText('100%');
  await expect(card.locator('.progress')).toHaveText('✓ 1/1');
  await expect(card.locator('.progress')).toHaveClass(/complete/);
  await checkpoint(page, 'angular-checklist-completion-restored');
  complete();
});
