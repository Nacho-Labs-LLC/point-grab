/** Source-derived storefront branches omitted by solid.spec.mts. */
import { test, expect, openApp } from '../fixtures.mts';
import { checkpoint } from '../../checkpoint';

const complete = () => test.info().annotations.push({ type: 'coverage', description: 'demo-complete' });
test.beforeEach(async ({ page, errors }) => { void errors; await openApp(page); });

test('filters: Lighting and Essentials intersect saved, name and detail search', async ({ page }) => {
  const cards = page.getByTestId('product-card');
  const savedOnly = page.getByRole('button', { name: '♡ Saved only', exact: true });
  await page.getByRole('button', { name: 'Save Arc lamp', exact: true }).click();
  await page.getByRole('button', { name: 'Lighting', exact: true }).click();
  await expect(cards).toHaveCount(1);
  await expect(cards.getByRole('heading')).toHaveText('Arc lamp');
  await expect(page.getByRole('button', { name: 'Lighting', exact: true })).toHaveAttribute('aria-pressed', 'true');
  await checkpoint(page, 'solid-lighting-category');
  await savedOnly.click();
  await page.getByLabel('Search objects').fill('SPOTLIGHT');
  await expect(cards).toHaveCount(1);
  await expect(cards.getByRole('heading')).toHaveText('Arc lamp');
  await expect(savedOnly).toHaveAttribute('aria-pressed', 'true');
  await expect(cards.getByRole('button', { name: 'Save Arc lamp', exact: true })).toHaveAttribute('aria-pressed', 'true');
  await checkpoint(page, 'solid-combined-lighting-saved-detail-search');
  await page.getByRole('button', { name: 'Essentials', exact: true }).click();
  await expect(cards).toHaveCount(0);
  await expect(page.getByRole('heading', { name: 'No objects found.', exact: true })).toBeVisible();
  await expect(page.getByRole('button', { name: 'Essentials', exact: true })).toHaveAttribute('aria-pressed', 'true');
  await checkpoint(page, 'solid-combined-filters-no-objects');
  await page.getByRole('button', { name: 'Reset filters', exact: true }).click();
  await expect(cards).toHaveCount(3);
  await expect(page.getByLabel('Search objects')).toHaveValue('');
  await expect(savedOnly).toHaveAttribute('aria-pressed', 'false');
  await expect(page.getByRole('button', { name: 'All objects', exact: true })).toHaveAttribute('aria-pressed', 'true');
  await expect(page.getByRole('button', { name: 'Essentials', exact: true })).toHaveAttribute('aria-pressed', 'false');
  await expect(page.getByRole('button', { name: 'Save Arc lamp', exact: true })).toHaveAttribute('aria-pressed', 'true');
  await expect(page.getByRole('button', { name: 'Reset filters', exact: true })).toHaveCount(0);
  await checkpoint(page, 'solid-reset-all-filters-preserves-save');
  await page.getByRole('button', { name: 'Essentials', exact: true }).click();
  await page.getByLabel('Search objects').fill('TOTE');
  await expect(cards).toHaveCount(1);
  await expect(cards.getByRole('heading')).toHaveText('Everyday tote');
  await checkpoint(page, 'solid-essentials-category-name-search');
  complete();
});

test('saved only: empty state, unsave removal, and reset do not restore saved items', async ({ page }) => {
  const cards = page.getByTestId('product-card');
  const savedOnly = page.getByRole('button', { name: '♡ Saved only', exact: true });
  await savedOnly.click();
  await expect(cards).toHaveCount(0);
  await expect(page.getByRole('heading', { name: 'No objects found.', exact: true })).toBeVisible();
  await checkpoint(page, 'solid-saved-only-initially-empty');
  await page.getByRole('button', { name: 'Reset filters', exact: true }).click();
  await expect(cards).toHaveCount(3);
  await expect(savedOnly).toHaveAttribute('aria-pressed', 'false');
  await checkpoint(page, 'solid-empty-saved-reset');
  const save = page.getByRole('button', { name: 'Save Pebble vase', exact: true });
  await save.click();
  await expect(save).toHaveAttribute('aria-pressed', 'true');
  await savedOnly.click();
  await expect(cards).toHaveCount(1);
  await expect(cards.getByRole('heading')).toHaveText('Pebble vase');
  await checkpoint(page, 'solid-saved-vase-only');
  await save.click();
  await expect(cards).toHaveCount(0);
  await expect(page.getByRole('heading', { name: 'No objects found.', exact: true })).toBeVisible();
  await expect(savedOnly).toHaveAttribute('aria-pressed', 'true');
  await checkpoint(page, 'solid-unsave-removes-last-saved-card');
  await page.getByRole('button', { name: 'Reset filters', exact: true }).click();
  await expect(cards).toHaveCount(3);
  await expect(save).toHaveAttribute('aria-pressed', 'false');
  await expect(page.getByRole('button', { name: 'Save Arc lamp', exact: true })).toHaveAttribute('aria-pressed', 'false');
  await checkpoint(page, 'solid-reset-keeps-vase-unsaved');
  complete();
});

test('search: unmatched query resets without clearing the bag or gift note', async ({ page }) => {
  await page.getByRole('button', { name: 'Add Everyday tote to bag', exact: true }).click();
  await page.getByLabel('Gift note', { exact: true }).fill('For your next adventure');
  await expect(page.getByTestId('bag-count')).toHaveText('1');
  await expect(page.getByTestId('bag-total')).toHaveText('$28');
  await expect(page.getByLabel('Gift note', { exact: true })).toHaveValue('For your next adventure');
  await checkpoint(page, 'solid-bag-and-gift-note-before-filter');
  await page.getByLabel('Search objects').fill('no-such-field-object');
  await expect(page.getByTestId('product-card')).toHaveCount(0);
  await expect(page.getByRole('heading', { name: 'No objects found.', exact: true })).toBeVisible();
  await expect(page.getByTestId('bag-total')).toHaveText('$28');
  await checkpoint(page, 'solid-unmatched-search-retains-bag');
  await page.getByRole('button', { name: 'Reset filters', exact: true }).click();
  await expect(page.getByTestId('product-card')).toHaveCount(3);
  await expect(page.getByLabel('Search objects')).toHaveValue('');
  await expect(page.getByTestId('bag-count')).toHaveText('1');
  await expect(page.getByTestId('bag-total')).toHaveText('$28');
  await expect(page.getByLabel('Gift note', { exact: true })).toHaveValue('For your next adventure');
  await checkpoint(page, 'solid-search-reset-preserves-bag-and-note');
  complete();
});

test('bag: decrement above one retains the line and recomputes quantity and subtotal', async ({ page }) => {
  await page.getByRole('button', { name: 'Add Pebble vase to bag', exact: true }).click();
  await page.getByRole('button', { name: 'Increase Pebble vase quantity', exact: true }).click();
  await expect(page.getByLabel('Pebble vase quantity', { exact: true })).toHaveText('2');
  await expect(page.getByTestId('bag-count')).toHaveText('2');
  await expect(page.getByTestId('bag-total')).toHaveText('$84');
  await checkpoint(page, 'solid-bag-vase-quantity-two');
  await page.getByRole('button', { name: 'Decrease Pebble vase quantity', exact: true }).click();
  await expect(page.getByLabel('Pebble vase quantity', { exact: true })).toHaveText('1');
  await expect(page.getByTestId('bag-count')).toHaveText('1');
  await expect(page.getByTestId('bag-total')).toHaveText('$42');
  await expect(page.getByRole('button', { name: 'Decrease Pebble vase quantity', exact: true })).toBeVisible();
  await checkpoint(page, 'solid-bag-decrement-retains-line');
  await page.getByRole('button', { name: 'Decrease Pebble vase quantity', exact: true }).click();
  await expect(page.getByLabel('Pebble vase quantity', { exact: true })).toHaveCount(0);
  await expect(page.getByTestId('bag-count')).toHaveText('0');
  await expect(page.getByTestId('bag-total')).toHaveCount(0);
  await expect(page.getByText('Your bag is a blank canvas.', { exact: true })).toBeVisible();
  await checkpoint(page, 'solid-bag-decrement-last-unit-empty');
  complete();
});
