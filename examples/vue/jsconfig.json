{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "maxNodeModuleJsDepth": 0,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": ["src/**/*.js", "src/**/*.vue"]
}
