---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import CopyButton from "../components/CopyButton.astro";
import Badge from "../components/Badge.astro";
import FrameworkIcon from "../components/FrameworkIcon.astro";
import LiveDemo from "../components/LiveDemo.astro";
---

<Base title="pointgrab — Point at any element. Grab its full context.">

  <!-- ═══════════════════════════════════════════
       HERO
       ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden px-6 pb-24 pt-24 sm:pt-32 lg:pt-40">
    <!-- Radial glow -->
    <div
      class="pointer-events-none absolute inset-0 -top-40 mx-auto max-w-4xl opacity-25"
      style="background: radial-gradient(ellipse at 50% 0%, var(--color-pointgrab-blue) 0%, transparent 70%);"
    ></div>

    <div class="relative mx-auto max-w-[var(--width-content)]">
      <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
        <Badge variant="blue" size="md" class="mb-6">
          Platform-agnostic element inspector
        </Badge>

        <h1 class="bg-gradient-to-r from-pointgrab-blue via-[#a78bfa] to-pointgrab-blue bg-clip-text text-4xl font-extrabold tracking-tight text-transparent sm:text-5xl lg:text-6xl">
          Point. Grab. Ship.
        </h1>

        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-text-muted sm:text-xl">
          Grab any element's full context — HTML, component name, source file, styles — and hand it to your AI agent. Works with every framework.
        </p>

        <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row">
          <CopyButton
            text="npm install pointgrab"
            label="npm install pointgrab"
            class="shadow-[var(--shadow-glow-blue)] hover:shadow-[var(--shadow-glow-blue-strong)] border-pointgrab-blue/50 hover:border-pointgrab-blue"
          />
          <a
            href="https://github.com/pointgrab/pointgrab"
            class="inline-flex items-center gap-2 rounded-xl border border-border px-5 py-3 text-sm text-text-muted transition-all hover:border-border-bright hover:text-text-heading"
          >
            View on GitHub
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Live interactive demo -->
      <div class="mx-auto mt-16">
        <LiveDemo />
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       FRAMEWORK SHOWCASE
       ═══════════════════════════════════════════ -->
  <Section id="frameworks" background="raised">
    <div class="text-center">
      <Badge variant="blue" class="mb-4">Frameworks</Badge>
      <h2 class="text-3xl font-bold md:text-4xl">
        Every framework. One tool.
      </h2>
    </div>

    <div class="mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <!-- Angular -->
      <div class="group rounded-xl border border-border bg-bg p-6 transition-all hover:border-border-bright hover:shadow-[var(--shadow-glow-blue)]">
        <div class="mb-4 flex items-center gap-3">
          <FrameworkIcon name="angular" size={36} />
          <div>
            <h3 class="font-semibold text-text-heading">Angular</h3>
            <code class="text-xs text-text-faint">@point-grab/angular</code>
          </div>
        </div>
        <p class="text-sm leading-relaxed text-text-muted">
          Reads the component tree via NgZone for component names, template references, and source locations.
        </p>
      </div>

      <!-- React -->
      <div class="group rounded-xl border border-border bg-bg p-6 transition-all hover:border-border-bright hover:shadow-[var(--shadow-glow-blue)]">
        <div class="mb-4 flex items-center gap-3">
          <FrameworkIcon name="react" size={36} />
          <div>
            <h3 class="font-semibold text-text-heading">React</h3>
            <code class="text-xs text-text-faint">@point-grab/react</code>
          </div>
        </div>
        <p class="text-sm leading-relaxed text-text-muted">
          Walks the fiber tree for component names and source file paths with line numbers.
        </p>
      </div>

      <!-- Vue -->
      <div class="group rounded-xl border border-border bg-bg p-6 transition-all hover:border-border-bright hover:shadow-[var(--shadow-glow-blue)]">
        <div class="mb-4 flex items-center gap-3">
          <FrameworkIcon name="vue" size={36} />
          <div>
            <h3 class="font-semibold text-text-heading">Vue</h3>
            <code class="text-xs text-text-faint">@point-grab/vue</code>
          </div>
        </div>
        <p class="text-sm leading-relaxed text-text-muted">
          Traverses the Vue instance tree, resolving SFC file paths and stripping <code class="text-text-faint">data-v-*</code> scoped hashes.
        </p>
      </div>

      <!-- Svelte -->
      <div class="group rounded-xl border border-border bg-bg p-6 transition-all hover:border-border-bright hover:shadow-[var(--shadow-glow-blue)]">
        <div class="mb-4 flex items-center gap-3">
          <FrameworkIcon name="svelte" size={36} />
          <div>
            <h3 class="font-semibold text-text-heading">Svelte</h3>
            <code class="text-xs text-text-faint">@point-grab/svelte</code>
          </div>
        </div>
        <p class="text-sm leading-relaxed text-text-muted">
          Uses Svelte's internal component context to extract component boundaries and source mappings.
        </p>
      </div>

      <!-- Web Components -->
      <div class="group rounded-xl border border-border bg-bg p-6 transition-all hover:border-border-bright hover:shadow-[var(--shadow-glow-blue)]">
        <div class="mb-4 flex items-center gap-3">
          <FrameworkIcon name="webcomponents" size={36} />
          <div>
            <h3 class="font-semibold text-text-heading">Web Components</h3>
            <code class="text-xs text-text-faint">@point-grab/web-components</code>
          </div>
        </div>
        <p class="text-sm leading-relaxed text-text-muted">
          Pierces shadow DOM boundaries and maps custom element tag names back to their class definitions.
        </p>
      </div>

      <!-- Vanilla JS -->
      <div class="group rounded-xl border border-border bg-bg p-6 transition-all hover:border-border-bright hover:shadow-[var(--shadow-glow-blue)]">
        <div class="mb-4 flex items-center gap-3">
          <FrameworkIcon name="html" size={36} />
          <div>
            <h3 class="font-semibold text-text-heading">Vanilla JS</h3>
            <code class="text-xs text-text-faint">pointgrab</code>
          </div>
        </div>
        <p class="text-sm leading-relaxed text-text-muted">
          Pure DOM inspection with CSS selector generation. Zero dependencies, works in any page.
        </p>
      </div>
    </div>

    <p class="mt-10 text-center text-sm text-text-faint">
      Or use the core <code class="rounded bg-bg-muted px-1.5 py-0.5 text-text-muted">pointgrab</code> package directly — zero dependencies, works everywhere.
    </p>
  </Section>

  <!-- ═══════════════════════════════════════════
       HOW IT WORKS
       ═══════════════════════════════════════════ -->
  <Section id="features">
    <div class="text-center">
      <Badge variant="amber" class="mb-4">How it works</Badge>
      <h2 class="text-3xl font-bold md:text-4xl">
        Three steps. Zero guesswork.
      </h2>
    </div>

    <div class="mt-16 grid gap-8 sm:gap-6 lg:grid-cols-3">
      <!-- Step 1: Point -->
      <div class="rounded-xl border border-border bg-bg-raised p-8">
        <div class="mb-4 flex items-center gap-4">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-pointgrab-blue/10 text-pointgrab-blue">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10" />
              <circle cx="12" cy="12" r="3" />
              <line x1="12" y1="2" x2="12" y2="6" />
              <line x1="12" y1="18" x2="12" y2="22" />
              <line x1="2" y1="12" x2="6" y2="12" />
              <line x1="18" y1="12" x2="22" y2="12" />
            </svg>
          </div>
          <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-pointgrab-blue">Step 1</span>
            <h3 class="text-lg font-bold text-text-heading">Point</h3>
          </div>
        </div>
        <p class="text-sm leading-relaxed text-text-muted">
          Hold your activation key and hover. PointGrab highlights the element and shows its component name in a floating label.
        </p>
      </div>

      <!-- Step 2: Grab -->
      <div class="rounded-xl border border-border bg-bg-raised p-8">
        <div class="mb-4 flex items-center gap-4">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-pointgrab-blue/10 text-pointgrab-blue">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            </svg>
          </div>
          <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-pointgrab-blue">Step 2</span>
            <h3 class="text-lg font-bold text-text-heading">Grab</h3>
          </div>
        </div>
        <p class="text-sm leading-relaxed text-text-muted">
          Click to capture. HTML, CSS selector, component stack, source file path — all copied instantly.
        </p>
      </div>

      <!-- Step 3: Ship -->
      <div class="rounded-xl border border-border bg-bg-raised p-8">
        <div class="mb-4 flex items-center gap-4">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-pointgrab-blue/10 text-pointgrab-blue">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M22 2L11 13" />
              <path d="M22 2L15 22l-4-9-9-4z" />
            </svg>
          </div>
          <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-pointgrab-blue">Step 3</span>
            <h3 class="text-lg font-bold text-text-heading">Ship</h3>
          </div>
        </div>
        <p class="text-sm leading-relaxed text-text-muted">
          Paste into Claude Code, Cursor, or any AI agent. Or let the MCP server send it automatically.
        </p>
      </div>
    </div>
  </Section>

  <!-- ═══════════════════════════════════════════
       COMMENT MODE — THE KILLER FEATURE
       ═══════════════════════════════════════════ -->
  <Section id="comment-mode" background="raised">
    <div class="text-center">
      <Badge variant="amber" class="mb-4">Comment mode</Badge>
      <h2 class="text-3xl font-bold md:text-4xl">
        Point at a bug. Tell your agent what to fix.
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-text-muted">
        Don't just capture what's there — tell your AI agent what to change. Attach natural language instructions directly to any element.
      </p>
    </div>

    <div class="mx-auto mt-16 max-w-[var(--width-narrow)]">
      <!-- Before / After comparison -->
      <div class="grid gap-6 md:grid-cols-2">
        <!-- Without comment -->
        <div class="rounded-xl border border-border bg-bg p-5">
          <div class="mb-3 flex items-center gap-2">
            <div class="flex h-6 w-6 items-center justify-center rounded bg-bg-muted text-text-faint">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
              </svg>
            </div>
            <span class="text-xs font-semibold uppercase tracking-wider text-text-faint">Standard grab</span>
          </div>
          <pre class="overflow-x-auto rounded-lg bg-bg-muted p-4 text-xs leading-relaxed"><code><span class="text-text-faint">&lt;</span><span class="text-pointgrab-blue">button</span> <span class="text-amber">class</span><span class="text-text-faint">=</span><span class="text-success">"btn-primary"</span><span class="text-text-faint">&gt;</span>
  Submit Order
<span class="text-text-faint">&lt;/</span><span class="text-pointgrab-blue">button</span><span class="text-text-faint">&gt;</span>

<span class="text-text-faint">in</span> <span class="text-[#a78bfa]">SubmitButton</span> <span class="text-text-faint">at</span> <span class="text-text-muted">src/components/SubmitButton.tsx</span><span class="text-text-faint">:</span><span class="text-amber">24</span></code></pre>
          <p class="mt-3 text-xs text-text-faint">Your agent has the element — but not your intent.</p>
        </div>

        <!-- With comment -->
        <div class="rounded-xl border border-amber/30 bg-amber/5 p-5 shadow-[var(--shadow-glow-amber)]">
          <div class="mb-3 flex items-center gap-2">
            <div class="flex h-6 w-6 items-center justify-center rounded bg-amber/10 text-amber">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
              </svg>
            </div>
            <span class="text-xs font-semibold uppercase tracking-wider text-amber">With comment</span>
          </div>
          <pre class="overflow-x-auto rounded-lg bg-bg-muted p-4 text-xs leading-relaxed"><code><span class="text-text-faint">&lt;</span><span class="text-pointgrab-blue">button</span> <span class="text-amber">class</span><span class="text-text-faint">=</span><span class="text-success">"btn-primary"</span><span class="text-text-faint">&gt;</span>
  Submit Order
<span class="text-text-faint">&lt;/</span><span class="text-pointgrab-blue">button</span><span class="text-text-faint">&gt;</span>

<span class="text-text-faint">in</span> <span class="text-[#a78bfa]">SubmitButton</span> <span class="text-text-faint">at</span> <span class="text-text-muted">src/components/SubmitButton.tsx</span><span class="text-text-faint">:</span><span class="text-amber">24</span>

<span class="text-text-faint">/*</span> <span class="text-amber">Comment:</span> <span class="text-text">Disable this button while the</span>
<span class="text-text">form is submitting and show a spinner</span> <span class="text-text-faint">*/</span></code></pre>
          <p class="mt-3 text-xs text-amber">Your agent knows exactly what you want changed.</p>
        </div>
      </div>

      <!-- How it flows -->
      <div class="mt-12 grid gap-4 sm:grid-cols-3">
        <div class="flex items-start gap-3 rounded-lg border border-border bg-bg p-4">
          <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-pointgrab-blue/10 text-xs font-bold text-pointgrab-blue">1</div>
          <div>
            <div class="text-sm font-medium text-text-heading">Click any element</div>
            <p class="mt-1 text-xs text-text-faint">Choose "Add comment" from the actions menu</p>
          </div>
        </div>
        <div class="flex items-start gap-3 rounded-lg border border-border bg-bg p-4">
          <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-pointgrab-blue/10 text-xs font-bold text-pointgrab-blue">2</div>
          <div>
            <div class="text-sm font-medium text-text-heading">Type your instruction</div>
            <p class="mt-1 text-xs text-text-faint">Natural language — anything your AI agent should know</p>
          </div>
        </div>
        <div class="flex items-start gap-3 rounded-lg border border-border bg-bg p-4">
          <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-pointgrab-blue/10 text-xs font-bold text-pointgrab-blue">3</div>
          <div>
            <div class="text-sm font-medium text-text-heading">Paste or auto-send</div>
            <p class="mt-1 text-xs text-text-faint">Comment is in your clipboard and flows through MCP to your agent</p>
          </div>
        </div>
      </div>

      <!-- Callout -->
      <div class="mt-8 rounded-lg border border-amber/20 bg-amber/5 p-4">
        <p class="text-sm text-text-muted">
          <span class="font-semibold text-amber">MCP integration:</span>
          Comments automatically flow through the <code class="rounded bg-bg-muted px-1 text-xs text-text-faint">onCopySuccess</code> hook with the <code class="rounded bg-bg-muted px-1 text-xs text-text-faint">prompt</code> parameter — your MCP server receives both the element context and your instruction in one payload.
        </p>
      </div>
    </div>
  </Section>

  <!-- ═══════════════════════════════════════════
       WHAT GETS CAPTURED
       ═══════════════════════════════════════════ -->
  <Section>
    <div class="text-center">
      <Badge variant="amber" class="mb-4">Output</Badge>
      <h2 class="text-3xl font-bold md:text-4xl">
        Everything your agent needs. Nothing it doesn't.
      </h2>
    </div>

    <div class="mx-auto mt-16 max-w-[var(--width-narrow)]">
      <!-- Code block showing pointgrab output -->
      <div class="group relative overflow-hidden rounded-xl border border-border bg-bg-muted">
        <div class="flex items-center justify-between border-b border-border px-4 py-2.5">
          <div class="flex items-center gap-2 text-xs text-text-faint">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            <span>pointgrab output</span>
          </div>
          <span class="rounded border border-border px-2 py-0.5 text-[10px] text-text-faint">clipboard</span>
        </div>
        <pre class="overflow-x-auto p-6 text-sm leading-relaxed"><code><span class="text-text-faint">&lt;</span><span class="text-pointgrab-blue">button</span> <span class="text-amber">class</span><span class="text-text-faint">=</span><span class="text-success">"btn-primary"</span> <span class="text-amber">disabled</span><span class="text-text-faint">&gt;</span>
  Submit Order
<span class="text-text-faint">&lt;/</span><span class="text-pointgrab-blue">button</span><span class="text-text-faint">&gt;</span>

<span class="text-text-muted">in</span> <span class="text-[#a78bfa]">SubmitButton</span> <span class="text-text-muted">at</span> <span class="text-text">src/components/checkout/SubmitButton.tsx</span><span class="text-text-faint">:</span><span class="text-amber">24</span>
<span class="text-text-muted">in</span> <span class="text-[#a78bfa]">CheckoutForm</span> <span class="text-text-muted">at</span> <span class="text-text">src/components/checkout/CheckoutForm.tsx</span><span class="text-text-faint">:</span><span class="text-amber">8</span>
<span class="text-text-muted">in</span> <span class="text-[#a78bfa]">App</span> <span class="text-text-muted">at</span> <span class="text-text">src/App.tsx</span><span class="text-text-faint">:</span><span class="text-amber">3</span></code></pre>
      </div>

      <!-- Annotations -->
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        <div class="rounded-lg border border-border bg-bg p-4">
          <div class="mb-1 text-xs font-semibold uppercase tracking-wider text-pointgrab-blue">Cleaned HTML</div>
          <p class="text-sm text-text-muted">Framework-specific attributes stripped. Just the markup your agent needs.</p>
        </div>
        <div class="rounded-lg border border-border bg-bg p-4">
          <div class="mb-1 text-xs font-semibold uppercase tracking-wider text-[#a78bfa]">Component + Source</div>
          <p class="text-sm text-text-muted">Component name and the exact source file path with line number.</p>
        </div>
        <div class="rounded-lg border border-border bg-bg p-4">
          <div class="mb-1 text-xs font-semibold uppercase tracking-wider text-amber">Ancestor Chain</div>
          <p class="text-sm text-text-muted">Full component ancestry from the target up to the root, each with file paths.</p>
        </div>
      </div>

      <!-- Callout -->
      <div class="mt-8 rounded-lg border border-pointgrab-blue/20 bg-pointgrab-blue/5 p-4">
        <p class="text-sm text-text-muted">
          <span class="font-semibold text-text">Automatic cleanup:</span>
          Framework-specific adapters strip internal attributes (<code class="rounded bg-bg-muted px-1 text-xs text-text-faint">_nghost-*</code>, <code class="rounded bg-bg-muted px-1 text-xs text-text-faint">data-v-*</code>, <code class="rounded bg-bg-muted px-1 text-xs text-text-faint">data-reactid</code>, etc.) automatically.
        </p>
      </div>
    </div>
  </Section>

  <!-- ═══════════════════════════════════════════
       MCP INTEGRATION
       ═══════════════════════════════════════════ -->
  <Section id="mcp">
    <div class="text-center">
      <Badge variant="amber" class="mb-4">MCP Integration</Badge>
      <h2 class="text-3xl font-bold md:text-4xl">
        Agents that see what you see.
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-text-muted">
        Connect pointgrab to your AI agent via MCP. Every grab is instantly searchable.
      </p>
    </div>

    <div class="mx-auto mt-16 max-w-[var(--width-narrow)]">
      <div class="grid gap-3">
        <div class="flex items-start gap-4 rounded-lg border border-border bg-bg-raised p-4">
          <code class="shrink-0 rounded bg-bg-muted px-2 py-1 text-sm text-pointgrab-blue">pointgrab_search</code>
          <p class="text-sm text-text-muted">Search grabs by text, component, file, or framework</p>
        </div>
        <div class="flex items-start gap-4 rounded-lg border border-border bg-bg-raised p-4">
          <code class="shrink-0 rounded bg-bg-muted px-2 py-1 text-sm text-pointgrab-blue">pointgrab_recent</code>
          <p class="text-sm text-text-muted">Get the latest grabs from your session</p>
        </div>
        <div class="flex items-start gap-4 rounded-lg border border-border bg-bg-raised p-4">
          <code class="shrink-0 rounded bg-bg-muted px-2 py-1 text-sm text-pointgrab-blue">pointgrab_get</code>
          <p class="text-sm text-text-muted">Get full context for a specific grab by ID</p>
        </div>
        <div class="flex items-start gap-4 rounded-lg border border-border bg-bg-raised p-4">
          <code class="shrink-0 rounded bg-bg-muted px-2 py-1 text-sm text-pointgrab-blue">pointgrab_stats</code>
          <p class="text-sm text-text-muted">Usage statistics across your inspection sessions</p>
        </div>
        <div class="flex items-start gap-4 rounded-lg border border-border bg-bg-raised p-4">
          <code class="shrink-0 rounded bg-bg-muted px-2 py-1 text-sm text-pointgrab-blue">pointgrab_frameworks</code>
          <p class="text-sm text-text-muted">Framework breakdown across inspected elements</p>
        </div>
      </div>

      <div class="mt-8 text-center">
        <a
          href="/docs/mcp"
          class="inline-flex items-center gap-2 text-sm font-medium text-pointgrab-blue transition-colors hover:text-pointgrab-blue-bright"
        >
          Read the MCP guide
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
