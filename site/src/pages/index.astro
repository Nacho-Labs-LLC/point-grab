---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import CopyButton from "../components/CopyButton.astro";
import Badge from "../components/Badge.astro";
import FrameworkIcon from "../components/FrameworkIcon.astro";
import LiveDemo from "../components/LiveDemo.astro";

const STACKBLITZ_DEMOS = {
  angular: "https://stackblitz.com/github/Nacho-Labs-LLC/point-grab/tree/main/stackblitz/angular?file=src%2Fmain.ts",
  react: "https://stackblitz.com/github/Nacho-Labs-LLC/point-grab/tree/main/stackblitz/react?file=src%2FApp.jsx",
  vue: "https://stackblitz.com/github/Nacho-Labs-LLC/point-grab/tree/main/stackblitz/vue?file=src%2FApp.vue",
  svelte: "https://stackblitz.com/github/Nacho-Labs-LLC/point-grab/tree/main/stackblitz/svelte?file=src%2FApp.svelte",
  webComponents: "https://stackblitz.com/github/Nacho-Labs-LLC/point-grab/tree/main/stackblitz/web-components?file=main.js",
  vanilla: "https://stackblitz.com/github/Nacho-Labs-LLC/point-grab/tree/main/stackblitz/vanilla?file=main.js",
} as const;
---

<Base title="point-grab — Point at any element. Grab its full context.">

  <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       HERO
       â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
  <section class="relative overflow-hidden px-6 pb-24 pt-24 sm:pt-32 lg:pt-40">
    <!-- Radial glow -->
    <div
      class="pointer-events-none absolute inset-0 -top-40 mx-auto max-w-4xl opacity-25"
      style="background: radial-gradient(ellipse at 50% 0%, var(--color-point-grab-blue) 0%, transparent 70%);"
    ></div>

    <div class="relative mx-auto max-w-[var(--width-content)]">
      <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
        <Badge variant="blue" size="md" class="mb-6">
          Platform-agnostic element inspector
        </Badge>

        <h1 class="bg-gradient-to-r from-point-grab-blue via-[#a78bfa] to-point-grab-blue bg-clip-text text-4xl font-extrabold tracking-tight text-transparent sm:text-5xl lg:text-6xl">
          Point. Grab. Ship.
        </h1>

        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-text-muted sm:text-xl">
          Your AI agent can't see your screen. Point at the element, grab its full context — HTML, component name, source file, line number — and hand it over. Works with every framework.
        </p>

        <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row">
          <CopyButton
            text="npm install @point-grab/core"
            label="npm install @point-grab/core"
            class="shadow-[var(--shadow-glow-blue)] hover:shadow-[var(--shadow-glow-blue-strong)] border-point-grab-blue/50 hover:border-point-grab-blue"
          />
          <a
            href="https://github.com/Nacho-Labs-LLC/point-grab"
            class="inline-flex items-center gap-2 rounded-xl border border-border px-5 py-3 text-sm text-text-muted transition-all hover:border-border-bright hover:text-text-heading"
          >
            View on GitHub
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Live interactive demo -->
      <div class="mx-auto mt-16">
        <LiveDemo />
      </div>
    </div>
  </section>

  <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       THE PROBLEM — WITHOUT vs WITH
       â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
  <Section id="features" background="raised">
    <div class="text-center">
      <Badge variant="amber" class="mb-4">The problem</Badge>
      <h2 class="text-3xl font-bold md:text-4xl">
        Your agent is coding blind.
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-text-muted">
        You see a broken button. Your agent sees a thousand files. The gap between what you're looking at and what your agent can act on is the bottleneck.
      </p>
    </div>

    <div class="mx-auto mt-16 max-w-[var(--width-narrow)]">
      <div class="grid gap-6 md:grid-cols-2">
        <!-- Without -->
        <div class="rounded-xl border border-border bg-bg p-6">
          <div class="mb-4 flex items-center gap-2">
            <div class="flex h-6 w-6 items-center justify-center rounded bg-error/10 text-error">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </div>
            <span class="text-xs font-semibold uppercase tracking-wider text-text-faint">Without point-grab</span>
          </div>
          <div class="space-y-3 text-sm text-text-muted">
            <p class="italic">"The submit button in the checkout form is broken — it's the blue one near the bottom"</p>
            <p class="italic">"Something's wrong with the sidebar, the third item from the top"</p>
            <p class="italic">"The loading spinner on the dashboard keeps showing"</p>
          </div>
          <p class="mt-4 text-xs text-text-faint">Your agent has to guess which file, which component, which element you mean.</p>
        </div>

        <!-- With -->
        <div class="rounded-xl border border-point-grab-blue/30 bg-point-grab-blue/5 p-6 shadow-[var(--shadow-glow-blue)]">
          <div class="mb-4 flex items-center gap-2">
            <div class="flex h-6 w-6 items-center justify-center rounded bg-point-grab-blue/10 text-point-grab-blue">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <span class="text-xs font-semibold uppercase tracking-wider text-point-grab-blue">With point-grab</span>
          </div>
          <pre class="overflow-x-auto rounded-lg bg-bg-muted p-4 text-xs leading-relaxed"><code><span class="text-text-faint">&lt;</span><span class="text-point-grab-blue">button</span> <span class="text-amber">class</span><span class="text-text-faint">=</span><span class="text-success">"btn-primary"</span><span class="text-text-faint">&gt;</span>
  Submit Order
<span class="text-text-faint">&lt;/</span><span class="text-point-grab-blue">button</span><span class="text-text-faint">&gt;</span>

<span class="text-text-faint">in</span> <span class="text-[#a78bfa]">SubmitButton</span> <span class="text-text-faint">at</span> <span class="text-text-muted">src/components/SubmitButton.tsx</span><span class="text-text-faint">:</span><span class="text-amber">24</span>
<span class="text-text-faint">in</span> <span class="text-[#a78bfa]">CheckoutForm</span> <span class="text-text-faint">at</span> <span class="text-text-muted">src/components/CheckoutForm.tsx</span><span class="text-text-faint">:</span><span class="text-amber">8</span></code></pre>
          <p class="mt-4 text-xs text-point-grab-blue">Exact element, exact file, exact line. No guessing.</p>
        </div>
      </div>
    </div>
  </Section>

  <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       HOW IT WORKS
       â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
  <Section>
    <div class="text-center">
      <Badge variant="blue" class="mb-4">How it works</Badge>
      <h2 class="text-3xl font-bold md:text-4xl">
        Three steps. Zero guesswork.
      </h2>
    </div>

    <div class="mt-16 grid gap-8 sm:gap-6 lg:grid-cols-3">
      <!-- Step 1: Point -->
      <div class="rounded-xl border border-border bg-bg-raised p-8">
        <div class="mb-4 flex items-center gap-4">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-point-grab-blue/10 text-point-grab-blue">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10" />
              <circle cx="12" cy="12" r="3" />
              <line x1="12" y1="2" x2="12" y2="6" />
              <line x1="12" y1="18" x2="12" y2="22" />
              <line x1="2" y1="12" x2="6" y2="12" />
              <line x1="18" y1="12" x2="22" y2="12" />
            </svg>
          </div>
          <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-point-grab-blue">Step 1</span>
            <h3 class="text-lg font-bold text-text-heading">Point</h3>
          </div>
        </div>
        <p class="text-sm leading-relaxed text-text-muted">
          Hold <kbd class="rounded border border-border bg-bg-muted px-1 py-0.5 text-[10px] text-text-muted">&#8984;C</kbd> and hover. A highlight overlay tracks your cursor with the component name in a floating label.
        </p>
      </div>

      <!-- Step 2: Grab -->
      <div class="rounded-xl border border-border bg-bg-raised p-8">
        <div class="mb-4 flex items-center gap-4">
          <div class="flex h-10 w-10 items-center justify-content rounded-lg bg-point-grab-blue/10 text-point-grab-blue">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            </svg>
          </div>
          <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-point-grab-blue">Step 2</span>
            <h3 class="text-lg font-bold text-text-heading">Grab</h3>
          </div>
        </div>
        <p class="text-sm leading-relaxed text-text-muted">
          Click to capture. Cleaned HTML, CSS selector, component ancestry, source file with line number — all on your clipboard instantly.
        </p>
      </div>

      <!-- Step 3: Ship -->
      <div class="rounded-xl border border-border bg-bg-raised p-8">
        <div class="mb-4 flex items-center gap-4">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-point-grab-blue/10 text-point-grab-blue">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M22 2L11 13" />
              <path d="M22 2L15 22l-4-9-9-4z" />
            </svg>
          </div>
          <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-point-grab-blue">Step 3</span>
            <h3 class="text-lg font-bold text-text-heading">Ship</h3>
          </div>
        </div>
        <p class="text-sm leading-relaxed text-text-muted">
          Paste into Claude Code, Cursor, or Windsurf. Or connect the MCP server and let your agent query grabs directly — no paste needed.
        </p>
      </div>
    </div>
  </Section>

  <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       COMMENT MODE — THE KILLER FEATURE
       â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
  <Section id="comment-mode" background="raised">
    <div class="text-center">
      <Badge variant="amber" class="mb-4">Comment mode</Badge>
      <h2 class="text-3xl font-bold md:text-4xl">
        Point at a bug. Tell your agent what to fix.
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-text-muted">
        Don't just capture what's there — attach natural language instructions directly to any element. Your agent gets the context <em>and</em> your intent in one payload.
      </p>
    </div>

    <div class="mx-auto mt-16 max-w-[var(--width-narrow)]">
      <!-- Before / After comparison -->
      <div class="grid gap-6 md:grid-cols-2">
        <!-- Without comment -->
        <div class="rounded-xl border border-border bg-bg p-5">
          <div class="mb-3 flex items-center gap-2">
            <div class="flex h-6 w-6 items-center justify-center rounded bg-bg-muted text-text-faint">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
              </svg>
            </div>
            <span class="text-xs font-semibold uppercase tracking-wider text-text-faint">Standard grab</span>
          </div>
          <pre class="overflow-x-auto rounded-lg bg-bg-muted p-4 text-xs leading-relaxed"><code><span class="text-text-faint">&lt;</span><span class="text-point-grab-blue">button</span> <span class="text-amber">class</span><span class="text-text-faint">=</span><span class="text-success">"btn-primary"</span><span class="text-text-faint">&gt;</span>
  Submit Order
<span class="text-text-faint">&lt;/</span><span class="text-point-grab-blue">button</span><span class="text-text-faint">&gt;</span>

<span class="text-text-faint">in</span> <span class="text-[#a78bfa]">SubmitButton</span> <span class="text-text-faint">at</span> <span class="text-text-muted">src/components/SubmitButton.tsx</span><span class="text-text-faint">:</span><span class="text-amber">24</span></code></pre>
          <p class="mt-3 text-xs text-text-faint">Your agent has the element — but not your intent.</p>
        </div>

        <!-- With comment -->
        <div class="rounded-xl border border-amber/30 bg-amber/5 p-5 shadow-[var(--shadow-glow-amber)]">
          <div class="mb-3 flex items-center gap-2">
            <div class="flex h-6 w-6 items-center justify-center rounded bg-amber/10 text-amber">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
              </svg>
            </div>
            <span class="text-xs font-semibold uppercase tracking-wider text-amber">With comment</span>
          </div>
          <pre class="overflow-x-auto rounded-lg bg-bg-muted p-4 text-xs leading-relaxed"><code><span class="text-text-faint">&lt;</span><span class="text-point-grab-blue">button</span> <span class="text-amber">class</span><span class="text-text-faint">=</span><span class="text-success">"btn-primary"</span><span class="text-text-faint">&gt;</span>
  Submit Order
<span class="text-text-faint">&lt;/</span><span class="text-point-grab-blue">button</span><span class="text-text-faint">&gt;</span>

<span class="text-text-faint">in</span> <span class="text-[#a78bfa]">SubmitButton</span> <span class="text-text-faint">at</span> <span class="text-text-muted">src/components/SubmitButton.tsx</span><span class="text-text-faint">:</span><span class="text-amber">24</span>

<span class="text-text-faint">/*</span> <span class="text-amber">Comment:</span> <span class="text-text">Disable this button while the</span>
<span class="text-text">form is submitting and show a spinner</span> <span class="text-text-faint">*/</span></code></pre>
          <p class="mt-3 text-xs text-amber">Your agent knows exactly what you want changed.</p>
        </div>
      </div>

      <!-- How it flows -->
      <div class="mt-12 grid gap-4 sm:grid-cols-3">
        <div class="flex items-start gap-3 rounded-lg border border-border bg-bg p-4">
          <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-point-grab-blue/10 text-xs font-bold text-point-grab-blue">1</div>
          <div>
            <div class="text-sm font-medium text-text-heading">Click any element</div>
            <p class="mt-1 text-xs text-text-faint">Choose "Add comment" from the actions menu</p>
          </div>
        </div>
        <div class="flex items-start gap-3 rounded-lg border border-border bg-bg p-4">
          <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-point-grab-blue/10 text-xs font-bold text-point-grab-blue">2</div>
          <div>
            <div class="text-sm font-medium text-text-heading">Type your instruction</div>
            <p class="mt-1 text-xs text-text-faint">Natural language — "fix this", "make it responsive", "add a loading state"</p>
          </div>
        </div>
        <div class="flex items-start gap-3 rounded-lg border border-border bg-bg p-4">
          <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-point-grab-blue/10 text-xs font-bold text-point-grab-blue">3</div>
          <div>
            <div class="text-sm font-medium text-text-heading">Paste or auto-send</div>
            <p class="mt-1 text-xs text-text-faint">Element + instruction on your clipboard and through MCP to your agent</p>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
       WHAT YOUR AGENT SEES
       â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
  <Section>
    <div class="text-center">
      <Badge variant="amber" class="mb-4">Output</Badge>
      <h2 class="text-3xl font-bold md:text-4xl">
        Everything your agent needs. Nothing it doesn't.
      </h2>
    </div>

    <div class="mx-auto mt-16 max-w-[var(--width-narrow)]">
      <!-- Code block showing point-grab output -->
      <div class="group relative overflow-hidden rounded-xl border border-border bg-bg-muted">
        <div class="flex items-center justify-between border-b border-border px-4 py-2.5">
          <div class="flex items-center gap-2 text-xs text-text-faint">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            <span>point-grab output</span>
          </div>
          <span class="rounded border border-border px-2 py-0.5 text-[10px] text-text-faint">clipboard</span>
        </div>
        <pre class="overflow-x-auto p-6 text-sm leading-relaxed"><code><span class="text-text-faint">&lt;</span><span class="text-point-grab-blue">button</span> <span class="text-amber">class</span><span class="text-text-faint">=</span><span class="text-success">"btn-primary"</span> <span class="text-amber">disabled</span><span class="text-text-faint">&gt;</span>
  Submit Order
<span class="text-text-faint">&lt;/</span><span class="text-point-grab-blue">button</span><span class="text-text-faint">&gt;</span>

<span class="text-text-muted">in</span> <span class="text-[#a78bfa]">SubmitButton</span> <span class="text-text-muted">at</span> <span class="text-text">src/components/checkout/SubmitButton.tsx</span><span class="text-text-faint">:</span><span class="text-amber">24</span>
<span class="text-text-muted">in</span> <span class="text-[#a78bfa]">CheckoutForm</span> <span class="text-text-muted">at</span> <span class="text-text">src/components/checkout/CheckoutForm.tsx</span><span class="text-text-faint">:</span><span class="text-amber">8</span>
<span class="text-text-muted">in</span> <span class="text-[#a78bfa]">App</span> <span class="text-text-muted">at</span> <span class="text-text">src/App.tsx</span><span class="text-text-faint">:</span><span class="text-amber">3</span></code></pre>
      </div>

      <!-- Annotations -->
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        <div class="rounded-lg border border-border bg-bg p-4">
          <div class="mb-1 text-xs font-semibold uppercase tracking-wider text-point-grab-blue">Cleaned HTML</div>
          <p class="text-sm text-text-muted">Framework attributes stripped automatically. <code class="text-text-faint">_nghost-*</code>, <code class="text-text-faint">data-v-*</code>, <code class="text-text-faint">data-reactid</code> — gone.</p>
        </div>
        <div class="rounded-lg border border-border bg-bg p-4">
          <div class="mb-1 text-xs font-semibold uppercase tracking-wider text-[#a78bfa]">Component + Source</div>
