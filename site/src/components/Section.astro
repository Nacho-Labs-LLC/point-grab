---
interface Props {
  id?: string;
  class?: string;
  narrow?: boolean;
  background?: "default" | "raised" | "muted";
  padding?: "sm" | "md" | "lg" | "xl";
}

const {
  id,
  class: className,
  narrow = false,
  background = "default",
  padding = "lg",
} = Astro.props;

const bgMap = {
  default: "",
  raised: "bg-bg-raised",
  muted: "bg-bg-muted",
};

const paddingMap = {
  sm: "py-12",
  md: "py-16",
  lg: "py-24",
  xl: "py-32",
};

const maxWidth = narrow
  ? "max-w-[var(--width-narrow)]"
  : "max-w-[var(--width-content)]";
---

<section
  id={id}
  class:list={[bgMap[background], paddingMap[padding], className]}
>
  <div class:list={["mx-auto px-6", maxWidth]}>
    <slot />
  </div>
</section>
