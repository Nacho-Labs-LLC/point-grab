---
interface Props {
  variant?: "default" | "blue" | "amber" | "success";
  size?: "sm" | "md";
  class?: string;
}

const {
  variant = "default",
  size = "sm",
  class: className,
} = Astro.props;

const variantStyles = {
  default: "bg-bg-muted text-text-muted border-border",
  blue: "bg-point-grab-blue/10 text-point-grab-blue-bright border-point-grab-blue/20",
  amber: "bg-amber/10 text-amber-bright border-amber/20",
  success: "bg-success/10 text-success border-success/20",
};

const sizeStyles = {
  sm: "px-2.5 py-0.5 text-xs",
  md: "px-3 py-1 text-sm",
};
---

<span
  class:list={[
    "inline-flex items-center rounded-full border font-medium",
    variantStyles[variant],
    sizeStyles[size],
    className,
  ]}
>
  <slot />
</span>
