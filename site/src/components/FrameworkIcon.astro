---
interface Props {
  name: "angular" | "react" | "vue" | "svelte" | "webcomponents" | "html";
  size?: number;
  class?: string;
}

const { name, size = 40, class: className } = Astro.props;
---

{name === "angular" && (
  <svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="none">
    <path d="M12 2L3 6.5V17.5L12 22L21 17.5V6.5L12 2Z" fill="#DD0031" opacity="0.9" />
    <path d="M12 2L3 6.5L12 22L21 6.5L12 2Z" fill="#C3002F" opacity="0.5" />
