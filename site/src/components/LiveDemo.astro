---
---

<div class="mx-auto max-w-[var(--width-content)]" id="pg-tour-wrapper">

  <!-- Step instruction bar -->
  <div class="mb-3 flex items-center gap-3">
    <div class="flex items-center gap-1.5">
      <div class="tour-dot active" data-step="0"></div>
      <div class="tour-dot" data-step="1"></div>
      <div class="tour-dot" data-step="2"></div>
    </div>
    <p id="tour-instruction" class="text-sm text-text-muted">
      Step 1 of 3 &mdash; Hold <kbd class="tour-kbd">&#8984;C</kbd> / <kbd class="tour-kbd">Ctrl+C</kbd>, hover any element, and click to grab it
    </p>
  </div>

  <!-- Browser chrome wrapper -->
  <div id="demo-container" class="overflow-hidden rounded-xl border border-border bg-bg-raised shadow-2xl shadow-black/50">

    <!-- Chrome bar -->
    <div class="flex items-center gap-2 border-b border-border bg-bg-muted px-4 py-3">
      <div class="h-3 w-3 rounded-full bg-error"></div>
      <div class="h-3 w-3 rounded-full bg-amber"></div>
      <div class="h-3 w-3 rounded-full bg-success"></div>
      <div class="ml-4 flex-1 rounded-md bg-bg px-3 py-1 font-mono text-xs text-text-faint">
        myapp.dev/dashboard
      </div>
      <div class="flex items-center gap-1.5 rounded-md border border-point-grab-blue/30 bg-point-grab-blue/10 px-2.5 py-1 text-[10px] font-medium text-point-grab-blue">
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-point-grab-blue"></span>
        point-grab active
      </div>
    </div>

    <!-- App content -->
    <div id="demo-app" class="relative p-5 sm:p-6" style="min-height: 340px;">

      <!-- App header -->
      <div class="mb-5 flex items-center justify-between">
        <div>
          <h3 class="text-sm font-semibold text-text-heading">Dashboard</h3>
          <p class="text-[11px] text-text-faint">Good morning, Alex</p>
        </div>
        <div class="flex items-center gap-2.5">
          <!-- Notification bell -->
          <div id="notif-wrapper" class="relative">
            <button
              id="notif-bell"
              class="relative rounded-lg border border-border bg-bg-muted p-2 text-text-muted transition-colors hover:border-border-bright hover:text-text"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
              </svg>
              <span class="absolute -right-1 -top-1 flex h-4 w-4 items-center justify-center rounded-full bg-error text-[9px] font-bold text-white">3</span>
            </button>
            <!-- Notification popover -->
            <div
              id="notif-popover"
              class="absolute right-0 top-full z-30 mt-2 hidden w-60 rounded-lg border border-border bg-bg-muted shadow-xl"
            >
              <div class="border-b border-border px-3 py-2">
                <span class="text-[11px] font-semibold text-text-heading">Notifications</span>
              </div>
              <div class="divide-y divide-border/50">
                <div class="flex items-start gap-2.5 px-3 py-2.5">
                  <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-point-grab-blue"></span>
                  <div>
                    <p class="text-[11px] text-text">New order <span class="text-text-faint">#1847</span> received</p>
                    <p class="mt-0.5 text-[10px] text-text-faint">2 min ago</p>
                  </div>
                </div>
                <div class="flex items-start gap-2.5 px-3 py-2.5">
                  <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-amber"></span>
                  <div>
                    <p class="text-[11px] text-text">Inventory low: <span class="text-text-faint">SKU-2291</span></p>
                    <p class="mt-0.5 text-[10px] text-text-faint">18 min ago</p>
                  </div>
                </div>
                <div class="flex items-start gap-2.5 px-3 py-2.5">
                  <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-success"></span>
                  <div>
                    <p class="text-[11px] text-text">Deploy <span class="text-text-faint">v2.4.1</span> succeeded</p>
                    <p class="mt-0.5 text-[10px] text-text-faint">1 hr ago</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="h-8 w-8 rounded-full bg-gradient-to-br from-point-grab-blue to-[#a78bfa]"></div>
        </div>
      </div>

      <!-- Stats grid -->
      <div class="mb-5 grid grid-cols-2 gap-2.5 sm:grid-cols-4">
        <div class="rounded-lg border border-border bg-bg-muted p-3">
          <div class="text-[10px] font-medium uppercase tracking-wider text-text-faint">Revenue</div>
          <div class="mt-1 text-base font-bold text-text-heading">$12,847</div>
          <div class="mt-0.5 text-[10px] text-success">+14.2%</div>
        </div>
        <div class="rounded-lg border border-border bg-bg-muted p-3">
          <div class="text-[10px] font-medium uppercase tracking-wider text-text-faint">Orders</div>
          <div class="mt-1 text-base font-bold text-text-heading">284</div>
          <div class="mt-0.5 text-[10px] text-success">+8.1%</div>
        </div>

        <!-- Fulfillment — animated progress bar (step 2 target) -->
        <div id="fulfillment-card" class="rounded-lg border border-border bg-bg-muted p-3 transition-shadow">
          <div class="text-[10px] font-medium uppercase tracking-wider text-text-faint">Fulfillment</div>
          <div id="progress-track" class="mt-2 h-2 overflow-hidden rounded-full bg-bg-raised">
            <div id="progress-bar" class="h-full rounded-full bg-point-grab-blue transition-all duration-500" style="width: 0%"></div>
          </div>
          <div class="mt-1 flex justify-between">
            <span id="progress-pct" class="text-[10px] text-text-faint">0%</span>
            <span class="text-[10px] text-text-faint">target 95%</span>
          </div>
        </div>

        <!-- Live status — cycling badge -->
        <div class="rounded-lg border border-border bg-bg-muted p-3">
          <div class="text-[10px] font-medium uppercase tracking-wider text-text-faint">Order #1845</div>
          <div id="live-badge" class="mt-2 inline-flex items-center gap-1 rounded-full bg-point-grab-blue/10 px-2 py-0.5 text-[10px] font-medium text-point-grab-blue transition-all duration-300">
            <span id="live-dot" class="h-1.5 w-1.5 animate-pulse rounded-full bg-point-grab-blue"></span>
            <span id="live-text">Syncing...</span>
          </div>
          <div class="mt-1 text-[10px] text-text-faint">$412.00</div>
        </div>
      </div>

      <!-- Orders list -->
      <div class="overflow-hidden rounded-lg border border-border">
        <div class="flex items-center justify-between border-b border-border bg-bg-muted px-4 py-2">
          <span class="text-xs font-semibold text-text-heading">Recent Orders</span>
          <button class="rounded-md bg-point-grab-blue px-2.5 py-1 text-[10px] font-medium text-white transition-colors hover:bg-point-grab-blue-bright">
            + New
          </button>
        </div>
        <div class="divide-y divide-border/30">
          <div class="flex items-center justify-between px-4 py-2.5 transition-colors hover:bg-bg-muted/50">
            <span class="font-mono text-[11px] text-text-muted">#1847</span>
            <span class="flex-1 px-3 text-[11px] text-text">Sarah Chen</span>
            <span class="inline-flex items-center gap-1 rounded-full bg-amber/10 px-2 py-0.5 text-[10px] font-medium text-amber">
              <span class="h-1 w-1 rounded-full bg-amber"></span>Processing
            </span>
          </div>
          <div class="flex items-center justify-between px-4 py-2.5 transition-colors hover:bg-bg-muted/50">
            <span class="font-mono text-[11px] text-text-muted">#1846</span>
            <span class="flex-1 px-3 text-[11px] text-text">Mike Johnson</span>
            <span class="inline-flex items-center gap-1 rounded-full bg-success/10 px-2 py-0.5 text-[10px] font-medium text-success">
              <span class="h-1 w-1 rounded-full bg-success"></span>Shipped
            </span>
          </div>
          <div class="flex items-center justify-between px-4 py-2.5 transition-colors hover:bg-bg-muted/50">
            <span class="font-mono text-[11px] text-text-muted">#1844</span>
            <span class="flex-1 px-3 text-[11px] text-text">Priya Patel</span>
            <span class="inline-flex items-center gap-1 rounded-full bg-success/10 px-2 py-0.5 text-[10px] font-medium text-success">
              <span class="h-1 w-1 rounded-full bg-success"></span>Delivered
            </span>
          </div>
        </div>
      </div>

      <!-- Freeze hint (shown in step 2) -->
      <div
        id="freeze-hint"
        class="absolute bottom-3 left-3 hidden items-center gap-2 rounded-lg border border-border/50 bg-bg/90 px-3 py-1.5 backdrop-blur-sm"
      >
        <kbd class="tour-kbd">F</kbd>
        <span class="text-[10px] text-text-faint">Freeze to inspect the animated bar</span>
      </div>
    </div>
  </div>

  <!-- Chat panel (slides in after each capture) -->
  <div id="tour-chat" class="mt-4 hidden overflow-hidden rounded-xl border border-border bg-bg-raised shadow-xl shadow-black/30">
    <!-- Chat header -->
    <div class="flex items-center gap-2.5 border-b border-border bg-bg-muted px-4 py-2.5">
      <div class="flex h-5 w-5 items-center justify-center rounded-full bg-gradient-to-br from-point-grab-blue to-[#a78bfa]">
        <svg class="h-2.5 w-2.5 text-white" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10 2a8 8 0 100 16A8 8 0 0010 2zm0 3a1 1 0 110 2 1 1 0 010-2zm0 3c.55 0 1 .45 1 1v4a1 1 0 11-2 0V9a1 1 0 011-1z"/>
        </svg>
      </div>
      <span class="text-xs font-medium text-text-heading">AI assistant</span>
      <span class="ml-auto rounded border border-border px-1.5 py-0.5 font-mono text-[9px] text-text-faint">point-grab context attached</span>
    </div>
    <!-- Message thread -->
    <div class="space-y-3 p-4">
      <!-- User message -->
      <div class="flex justify-end">
        <div class="max-w-[88%] rounded-lg rounded-tr-sm border border-point-grab-blue/20 bg-point-grab-blue/10 px-3 py-2">
          <pre id="chat-user-text" class="whitespace-pre-wrap font-sans text-xs leading-relaxed text-text"></pre>
        </div>
      </div>
      <!-- AI message -->
      <div class="flex items-start gap-2.5">
        <div class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-border bg-bg-muted">
          <span class="text-[9px] font-bold text-text-muted">AI</span>
        </div>
        <div class="max-w-[88%]">
          <div id="thinking-dots" class="flex items-center gap-1 px-1 py-2">
            <span class="thinking-dot h-1.5 w-1.5 rounded-full bg-text-faint"></span>
            <span class="thinking-dot h-1.5 w-1.5 rounded-full bg-text-faint"></span>
            <span class="thinking-dot h-1.5 w-1.5 rounded-full bg-text-faint"></span>
          </div>
          <pre id="ai-response-text" class="hidden whitespace-pre-wrap rounded-lg rounded-tl-sm border border-border bg-bg-muted px-3 py-2 font-sans text-xs leading-relaxed text-text"></pre>
        </div>
      </div>
    </div>
    <!-- Footer with continue button -->
    <div id="chat-footer" class="hidden items-center justify-between border-t border-border px-4 py-3">
      <span id="chat-progress-label" class="text-[11px] text-text-faint">Step 1 of 3 complete</span>
      <button
        id="tour-continue-btn"
        class="flex items-center gap-1.5 rounded-lg bg-point-grab-blue px-3 py-1.5 text-xs font-medium text-white transition-colors hover:bg-point-grab-blue-bright"
      >
        <span id="continue-label">Next: Freeze an animation</span>
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Tour complete card -->
  <div id="tour-complete" class="mt-4 hidden rounded-xl border border-success/25 bg-success/5 p-6 text-center">
    <div class="mb-3 flex justify-center">
      <div class="flex h-10 w-10 items-center justify-center rounded-full border border-success/30 bg-success/10">
        <svg class="h-5 w-5 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
      </div>
    </div>
    <h3 class="text-sm font-semibold text-text-heading">That&rsquo;s the full flow</h3>
    <p class="mt-1 text-xs text-text-muted">Element &rarr; context &rarr; AI. In under 3 seconds.</p>
    <a
      href="#install"
      class="mt-4 inline-flex items-center gap-1.5 rounded-lg bg-point-grab-blue px-4 py-2 text-xs font-medium text-white transition-colors hover:bg-point-grab-blue-bright"
    >
      Install in your project
      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
      </svg>
    </a>
  </div>

</div>

<style>
  .tour-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-border-bright);
    flex-shrink: 0;
    transition: background 0.3s, transform 0.3s;
  }
  .tour-dot.active {
    background: var(--color-point-grab-blue);
    transform: scale(1.35);
  }
  .tour-dot.done {
    background: var(--color-success);
  }

  .tour-kbd {
    font-family: var(--font-mono, monospace);
    font-size: 0.6rem;
    color: var(--color-text-muted);
    background: var(--color-bg-muted);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    padding: 1px 5px;
  }

  /* Thinking animation */
  .thinking-dot {
    animation: thinking 1.2s ease-in-out infinite;
  }
  .thinking-dot:nth-child(2) { animation-delay: 0.2s; }
  .thinking-dot:nth-child(3) { animation-delay: 0.4s; }

  @keyframes thinking {
    0%, 80%, 100% { opacity: 0.25; transform: translateY(0); }
    40%            { opacity: 1;    transform: translateY(-4px); }
  }

  /* Step target highlight ring */
  .pg-highlight {
    box-shadow: 0 0 0 2px var(--color-point-grab-blue),
                0 0 0 5px rgba(59, 130, 246, 0.18);
    animation: highlight-pulse 2s ease-in-out infinite;
  }

  @keyframes highlight-pulse {
    0%, 100% { box-shadow: 0 0 0 2px var(--color-point-grab-blue), 0 0 0 5px rgba(59, 130, 246, 0.18); }
    50%       { box-shadow: 0 0 0 2px var(--color-point-grab-blue), 0 0 0 9px rgba(59, 130, 246, 0.08); }
  }

  /* Slide-up entrance */
  @keyframes slide-up {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .slide-up { animation: slide-up 0.3s ease forwards; }
</style>

<script>
import { init as initPointGrab } from '../../../packages/core/src/index.ts';

(function () {

  // ── Tour step definitions ─────────────────────────────────────
  var STEPS = [
    {
      instruction: 'Step 1 of 3 — Hold <kbd class="tour-kbd">⌘C</kbd> / <kbd class="tour-kbd">Ctrl+C</kbd>, hover any element, and click to grab it',
      userPrompt: 'Can you make this stat card stand out more?\n\nGrabbed element:\n<div class="rounded-lg border border-border bg-bg-muted p-3">\n  <div class="text-[10px] ... text-text-faint">Revenue</div>\n  <div class="mt-1 text-base font-bold text-text-heading">$12,847</div>\n  <div class="mt-0.5 text-[10px] text-success">+14.2%</div>\n</div>\n\nComponent: StatCard · Dashboard.jsx:47\nSelector: .stats-grid > div:first-child',
      aiResponse: 'I can see the Revenue stat card in your Dashboard.\n\nTo give it an accent tint that makes it pop:\n\nSwap  border-border → border-indigo-500/40\nSwap  bg-bg-muted   → bg-indigo-500/5\n\nThat gives it a subtle indigo glow while keeping the dark theme consistent with the rest of your grid. Want me to add a hover scale effect too?',
      progressLabel: 'Step 1 of 3 complete',
      continueLabel: 'Next: Freeze an animation',
    },
    {
      instruction: 'Step 2 of 3 — The progress bar is animating. Press <kbd class="tour-kbd">F</kbd> to freeze it, then grab it.',
      userPrompt: 'Froze the page to grab this progress bar — can you make it a gradient and add some height?\n\nGrabbed element:\n<div id="progress-bar"\n  class="h-full rounded-full bg-point-grab-blue transition-all"\n  style="width: 63%">\n</div>\n\nParent: #progress-track → Fulfillment card\nComponent: Dashboard · Dashboard.jsx:82',
      aiResponse: 'Nice — freeze mode is exactly right for animated elements.\n\nFor a blue→violet gradient, replace bg-point-grab-blue with:\n\n  background: linear-gradient(to right, #3b82f6, #8b5cf6);\n\nIn Tailwind 4:\n  bg-gradient-to-r from-blue-500 to-violet-500\n\nAlso bump the track height to h-2.5 so the gradient has more room to breathe.',
      progressLabel: 'Step 2 of 3 complete',
      continueLabel: 'Next: Grab a popover element',
    },
    {
      instruction: 'Step 3 of 3 — Click the 🔔 to open notifications, then grab one of the items inside.',
      userPrompt: 'Opened the notification popover and grabbed one of the items. Can you add a dismiss button that shows on hover?\n\nGrabbed element:\n<div class="flex items-start gap-2.5 px-3 py-2.5">\n  <span class="h-2 w-2 rounded-full bg-point-grab-blue mt-1"></span>\n  <div>\n    <p class="text-[11px] text-text">New order #1847 received</p>\n    <p class="text-[10px] text-text-faint">2 min ago</p>\n  </div>\n</div>\n\nComponent: NotifPopover · Dashboard.jsx:118',
      aiResponse: 'Here\'s the updated notification item with a hover-reveal dismiss button:\n\n<div className="group flex items-start gap-2.5 px-3 py-2.5">\n  <span className="h-2 w-2 rounded-full bg-blue-500 mt-1 shrink-0" />\n  <div className="flex-1 min-w-0">\n    <p className="text-xs">New order #1847 received</p>\n    <p className="text-[10px] text-zinc-400">2 min ago</p>\n  </div>\n  <button className="opacity-0 group-hover:opacity-100\n    text-zinc-500 hover:text-zinc-300\n    text-xs transition-opacity ml-2">\n    ✕\n  </button>\n</div>\n\ngroup-hover keeps the ✕ hidden until the user hovers the row.',
      progressLabel: 'Tour complete',
      continueLabel: null,
    },
  ];

  var tourStep = 0;
  var capturing = false;
  var pointGrab = null;

  // ── Element refs ──────────────────────────────────────────────
  var instrEl       = document.getElementById('tour-instruction');
  var dots          = document.querySelectorAll('.tour-dot');
  var chatEl        = document.getElementById('tour-chat');
  var chatUserText  = document.getElementById('chat-user-text');
  var thinkingDots  = document.getElementById('thinking-dots');
  var aiRespEl      = document.getElementById('ai-response-text');
  var chatFooter    = document.getElementById('chat-footer');
  var chatProgLabel = document.getElementById('chat-progress-label');
  var contBtn       = document.getElementById('tour-continue-btn');
  var contLabel     = document.getElementById('continue-label');
  var completeEl    = document.getElementById('tour-complete');
  var freezeHint    = document.getElementById('freeze-hint');
  var fulfillCard   = document.getElementById('fulfillment-card');
  var notifBell     = document.getElementById('notif-bell');
  var notifPopover  = document.getElementById('notif-popover');

  // ── Tour state machine ────────────────────────────────────────
  function setStep(n) {
    tourStep = n;
    updateDots(n);
    updateInstruction(n);
    setHighlights(n);
  }

  function updateDots(n) {
    dots.forEach(function (d, i) {
      d.classList.remove('active', 'done');
      if (i < n)      d.classList.add('done');
      else if (i === n) d.classList.add('active');
    });
  }

  function updateInstruction(n) {
    if (instrEl && STEPS[n]) instrEl.innerHTML = STEPS[n].instruction;
  }

  function setHighlights(n) {
    if (fulfillCard) fulfillCard.classList.remove('pg-highlight');
    if (notifBell)   notifBell.classList.remove('pg-highlight');
    if (freezeHint)  { freezeHint.style.display = 'none'; }

    if (n === 1) {
      if (fulfillCard) fulfillCard.classList.add('pg-highlight');
      if (freezeHint)  freezeHint.style.display = 'flex';
    } else if (n === 2) {
      if (notifBell) notifBell.classList.add('pg-highlight');
    }
  }

  // ── Chat sequence ─────────────────────────────────────────────
  function showChat(n) {
    var data = STEPS[n];

    // Show panel
    chatEl.classList.remove('hidden');
    chatEl.classList.add('slide-up');

    setTimeout(function () {
      chatEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }, 80);

    // Populate user message
    chatUserText.textContent = data.userPrompt;

    // Reset AI area
    thinkingDots.style.display = 'flex';
    aiRespEl.classList.add('hidden');
    aiRespEl.textContent = '';
    chatFooter.style.display = 'none';

    // 1.5s thinking → typewrite response
    setTimeout(function () {
      thinkingDots.style.display = 'none';
      aiRespEl.classList.remove('hidden');
      typewrite(aiRespEl, data.aiResponse, 16, function () {
        chatProgLabel.textContent = data.progressLabel;
        if (data.continueLabel) {
          contLabel.textContent = data.continueLabel;
          chatFooter.style.display = 'flex';
        } else {
          // Final step — show complete after brief pause
          setTimeout(showComplete, 700);
        }
      });
    }, 1500);
  }

  function typewrite(el, text, msPerChar, onDone) {
    el.textContent = '';
    var i = 0;
    var t = setInterval(function () {
      el.textContent += text[i++];
      if (i >= text.length) {
        clearInterval(t);
        if (onDone) onDone();
      }
    }, msPerChar);
  }

  function showComplete() {
    chatEl.classList.add('hidden');
    completeEl.classList.remove('hidden');
    completeEl.classList.add('slide-up');
    // Mark all dots done
    dots.forEach(function (d) { d.classList.remove('active'); d.classList.add('done'); });
    if (instrEl) instrEl.textContent = 'Done — element → context → AI in under 3 seconds.';
  }

  // ── Continue button ───────────────────────────────────────────
  if (contBtn) {
    contBtn.addEventListener('click', function () {
      var next = tourStep + 1;
      if (next >= STEPS.length) { showComplete(); return; }

      // Reset chat panel
      chatEl.classList.add('hidden');
      chatEl.classList.remove('slide-up');
      capturing = false;

      setStep(next);
    });
  }

  // ── On capture ────────────────────────────────────────────────
  function isPointGrabFrozen() {
    var freezeEl = document.getElementById('__point-grab-freeze-overlay__');
    return !!freezeEl && getComputedStyle(freezeEl).display !== 'none';
  }

  function unfreezePointGrabIfNeeded() {
    if (!isPointGrabFrozen()) return;
    document.dispatchEvent(new KeyboardEvent('keydown', {
      key: 'f',
      bubbles: true,
      cancelable: true,
    }));
  }

  function settlePointGrabAfterCapture() {
    unfreezePointGrabIfNeeded();
    if (pointGrab && typeof pointGrab.deactivate === 'function') {
      pointGrab.deactivate();
    }
  }

  function onCapture() {
    if (capturing) return;
    if (tourStep >= STEPS.length) return;
    capturing = true;

    // The real freeze mode intentionally pauses page DOM mutation.
    // That conflicts with this marketing demo's own chat/progress UI,
    // so settle point-grab immediately after a successful capture.
    settlePointGrabAfterCapture();

    requestAnimationFrame(function () {
      showChat(tourStep);
    });

    // Re-arm after the chat sequence plays out (guard against double-fire)
    setTimeout(function () { capturing = false; }, 8000);
  }

  // ── Demo animations ───────────────────────────────────────────

  // Progress bar — loops 0 → 87 → reset
  var progBar = document.getElementById('progress-bar');
  var progPct = document.getElementById('progress-pct');
  var pv = 0, pd = 1, pausing = false;

  setInterval(function () {
    if (!progBar || pausing) return;
    pv += 1.8 + Math.random() * 1.4;
    if (pv >= 87) {
      pv = 87; pausing = true;
      progBar.style.width = '87%';
      if (progPct) progPct.textContent = '87%';
      setTimeout(function () {
        pv = 0; pausing = false;
        progBar.style.width = '0%';
        if (progPct) progPct.textContent = '0%';
      }, 2200);
      return;
    }
    progBar.style.width = Math.round(pv) + '%';
    if (progPct) progPct.textContent = Math.round(pv) + '%';
  }, 320);

  // Live status badge — cycles through states
  var liveText  = document.getElementById('live-text');
  var liveDot   = document.getElementById('live-dot');
  var liveBadge = document.getElementById('live-badge');
  var sidx = 0;
  var STATUSES = [
    { text: 'Syncing...',  badge: ['bg-point-grab-blue/10', 'text-point-grab-blue'], dot: 'bg-point-grab-blue' },
    { text: 'Validating',  badge: ['bg-amber/10', 'text-amber'],                    dot: 'bg-amber' },
    { text: 'Confirmed',   badge: ['bg-success/10', 'text-success'],                dot: 'bg-success' },
  ];
  var ALL_BADGE_CLS = ['bg-point-grab-blue/10','text-point-grab-blue','bg-amber/10','text-amber','bg-success/10','text-success'];
  var ALL_DOT_CLS   = ['bg-point-grab-blue','bg-amber','bg-success'];

  setInterval(function () {
    sidx = (sidx + 1) % STATUSES.length;
    var s = STATUSES[sidx];
    if (liveText)  liveText.textContent = s.text;
    if (liveBadge) { ALL_BADGE_CLS.forEach(function(c){liveBadge.classList.remove(c);}); s.badge.forEach(function(c){liveBadge.classList.add(c);}); }
    if (liveDot)   { ALL_DOT_CLS.forEach(function(c){liveDot.classList.remove(c);}); liveDot.classList.add(s.dot); }
  }, 2500);

  // Notification popover toggle
  if (notifBell && notifPopover) {
    notifBell.addEventListener('click', function (e) {
      e.stopPropagation();
      notifPopover.classList.toggle('hidden');
    });
    document.addEventListener('click', function () {
      if (notifPopover) notifPopover.classList.add('hidden');
    });
  }

  // ── Initialize point-grab ─────────────────────────────────────
  function initPG() {
    pointGrab = initPointGrab({
      activationMode: 'hold',
      showToolbar: true,
      enabled: true,
      devOnly: false,
    });

    pointGrab.registerPlugin({
      name: 'tour',
      hooks: {
        onCopySuccess: function () { onCapture(); },
      },
    });
  }

  initPG();
  setStep(0);

})();
</script>
