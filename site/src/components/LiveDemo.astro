---
---

<div class="mx-auto max-w-[var(--width-content)]" id="pg-live-demo">
  <section class="mb-3 rounded-xl border border-point-grab-blue/30 bg-point-grab-blue/5 p-4" aria-label="Point-grab feature quests" data-testid="quest-list">
    <p class="text-xs font-semibold uppercase tracking-wider text-point-grab-blue">Try these quests</p>
    <h3 class="mt-1 text-sm font-semibold text-text-heading">Build a useful review as you explore</h3>
    <p class="mt-1 text-xs text-text-muted">Complete any item in any order. Nothing is locked.</p>
    <div class="quest-rows mt-3">
      <div class="quest-row" role="checkbox" aria-checked="false" data-quest-id="revenue-comment" data-quest-status="pending">Comment the Revenue KPI</div>
      <div class="quest-row" role="checkbox" aria-checked="false" data-quest-id="fulfillment-skip" data-quest-status="pending">Skip the Fulfillment card</div>
      <div class="quest-row" role="checkbox" aria-checked="false" data-quest-id="notification-comment" data-quest-status="pending">Comment the order notification</div>
      <div class="quest-row" role="checkbox" aria-checked="false" data-quest-id="end-review" data-quest-status="pending">End Capture Mode with two notes</div>
    </div>
    <pre class="mt-3 max-h-40 overflow-auto rounded-lg border border-border bg-bg p-3 font-mono text-[11px] leading-relaxed text-text-muted" data-testid="prompt-preview">Your accepted review comments will appear here exactly as Point-grab writes them to the clipboard.</pre>
    <div class="mt-3 hidden rounded-lg border border-success/25 bg-success/5 p-3 text-xs text-success" data-testid="walkthrough-complete"></div>
  </section>

  <div class="overflow-hidden rounded-xl border border-border bg-bg-raised shadow-2xl shadow-black/50">
    <div class="flex items-center gap-2 border-b border-border bg-bg-muted px-4 py-3">
      <span class="h-3 w-3 rounded-full bg-error"></span><span class="h-3 w-3 rounded-full bg-amber"></span><span class="h-3 w-3 rounded-full bg-success"></span>
      <span class="ml-4 flex-1 rounded-md bg-bg px-3 py-1 font-mono text-xs text-text-faint">myapp.dev/dashboard</span>
      <span class="rounded-md border border-point-grab-blue/30 bg-point-grab-blue/10 px-2.5 py-1 text-[10px] font-medium text-point-grab-blue">Capture-ready</span>
    </div>

    <div class="relative p-5 sm:p-6">
      <div class="mb-5 flex items-center justify-between"><div><h3 class="text-sm font-semibold text-text-heading">Dashboard</h3><p class="text-[11px] text-text-faint">Good morning, Alex</p></div><div class="h-8 w-8 rounded-full bg-gradient-to-br from-point-grab-blue to-[#a78bfa]"></div></div>
      <div class="mb-5 grid grid-cols-2 gap-2.5 sm:grid-cols-4">
        <div id="revenue-card" class="rounded-lg border border-border bg-bg-muted p-3"><div class="text-[10px] font-medium uppercase tracking-wider text-text-faint">Revenue</div><div class="mt-1 text-base font-bold text-text-heading">$12,847</div><div class="mt-0.5 text-[10px] text-success">+14.2%</div></div>
        <div class="rounded-lg border border-border bg-bg-muted p-3"><div class="text-[10px] font-medium uppercase tracking-wider text-text-faint">Orders</div><div class="mt-1 text-base font-bold text-text-heading">284</div><div class="mt-0.5 text-[10px] text-success">+8.1%</div></div>
        <div id="fulfillment-card" class="rounded-lg border border-border bg-bg-muted p-3"><div class="text-[10px] font-medium uppercase tracking-wider text-text-faint">Fulfillment</div><div class="mt-2 h-2 overflow-hidden rounded-full bg-bg-raised"><div class="h-full w-[72%] rounded-full bg-point-grab-blue"></div></div><div class="mt-1 text-[10px] text-text-faint">72% toward target</div></div>
        <div class="rounded-lg border border-border bg-bg-muted p-3"><div class="text-[10px] font-medium uppercase tracking-wider text-text-faint">Order #1845</div><div class="mt-2 text-[10px] text-success">Confirmed</div><div class="mt-1 text-[10px] text-text-faint">$412.00</div></div>
      </div>
      <div id="notif-wrapper" class="rounded-lg border border-border bg-bg-muted p-4"><div class="flex items-start gap-3"><span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-point-grab-blue"></span><div><p class="text-xs text-text">New order <span class="text-text-faint">#1847</span> received</p><p class="mt-1 text-[10px] text-text-faint">2 min ago · make this status easy to dismiss without losing context.</p></div></div></div>
    </div>
  </div>
</div>

<style>
  .quest-rows { display: grid; gap: .45rem; }
  .quest-row { display: flex; align-items: center; gap: .5rem; color: var(--color-text-muted); font-size: .75rem; }
  .quest-row::before { content: '○'; color: var(--color-point-grab-blue); font-size: 1rem; }
  .quest-row[data-quest-status="complete"] { color: var(--color-success); }
  .quest-row[data-quest-status="complete"]::before { content: '✓'; }
</style>

<script>
import { init as initPointGrab } from '../../../packages/core/src/index.ts';

(function () {
  const root = document.getElementById('pg-live-demo');
  const questList = root.querySelector('[data-testid="quest-list"]');
  const preview = root.querySelector('[data-testid="prompt-preview"]');
  const completion = root.querySelector('[data-testid="walkthrough-complete"]');
  const annotations = [];
  const quests = { 'revenue-comment': false, 'fulfillment-skip': false, 'notification-comment': false, 'end-review': false };

  function targetMatches(target, selector) {
    const element = target?.element;
    return !!element && (element.matches(selector) || !!element.closest(selector));
  }
  function renderQuests() {
    Object.entries(quests).forEach(([id, complete]) => {
      const row = questList.querySelector(`[data-quest-id="${id}"]`);
      row.dataset.questStatus = complete ? 'complete' : 'pending';
      row.setAttribute('aria-checked', String(complete));
    });
  }
  function renderPreview() {
    preview.textContent = annotations.length
      ? annotations.map(({ snippet, comment }, index) => `## Element ${index + 1}\n${snippet}\n\nComment: ${comment}`).join('\n\n---\n\n')
      : 'Your accepted review comments will appear here exactly as Point-grab writes them to the clipboard.';
  }

  const pointGrab = initPointGrab({ devOnly: false, mcpWebhook: false });
  pointGrab.registerPlugin({ name: 'site-live-demo-preview', hooks: { onCopySuccess(snippet, _context, comment) {
    if (!comment || annotations.some((item) => item.snippet === snippet && item.comment === comment)) return;
    annotations.push({ snippet, comment });
    renderPreview();
  } } });
  window.addEventListener('point-grab:capture-session', (event) => {
    const { action, target, annotationCount } = event.detail || {};
    if (action === 'accepted' && targetMatches(target, '#revenue-card')) quests['revenue-comment'] = true;
    if (action === 'skipped' && targetMatches(target, '#fulfillment-card')) quests['fulfillment-skip'] = true;
    if (action === 'accepted' && targetMatches(target, '#notif-wrapper')) quests['notification-comment'] = true;
    if (action === 'ended' && annotationCount >= 2) {
      quests['end-review'] = true;
      completion.textContent = `${annotationCount} reviewed elements + comments are ready for your AI agent.`;
      completion.classList.remove('hidden');
    }
    renderQuests();
  });
  renderQuests();
  renderPreview();
})();
</script>
