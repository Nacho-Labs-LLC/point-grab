---
---

<div class="mx-auto max-w-4xl">
  <div id="demo-container" class="relative overflow-hidden rounded-xl border border-border bg-bg-raised shadow-2xl shadow-black/50">
    <!-- Browser chrome -->
    <div class="flex items-center gap-2 border-b border-border bg-bg-muted px-4 py-3">
      <div class="h-3 w-3 rounded-full bg-error"></div>
      <div class="h-3 w-3 rounded-full bg-amber"></div>
      <div class="h-3 w-3 rounded-full bg-success"></div>
      <div class="ml-4 flex-1 rounded-md bg-bg px-3 py-1 font-mono text-xs text-text-faint">
        localhost:5173
      </div>
      <div id="demo-status" class="flex items-center gap-1.5 rounded-md border border-pointgrab-blue/30 bg-pointgrab-blue/10 px-2.5 py-1 text-[10px] font-medium text-pointgrab-blue transition-all">
        <span class="h-1.5 w-1.5 rounded-full bg-pointgrab-blue animate-pulse"></span>
        pointgrab active
      </div>
    </div>

    <!-- App content — pointgrab inspects real DOM inside here -->
    <div id="demo-app" class="relative p-6 sm:p-8" style="min-height: 420px;">

      <!-- Top bar with notification bell -->
      <div class="mb-6 flex items-center justify-between">
        <div>
          <h3 class="text-lg font-semibold text-text-heading">Dashboard</h3>
          <p class="text-xs text-text-faint">Welcome back, Nate</p>
        </div>
        <div class="flex items-center gap-3">
          <!-- Notification bell with popover -->
          <div id="notif-wrapper" class="relative">
            <button
              id="notif-bell"
              class="relative rounded-lg border border-border bg-bg-muted p-2 text-text-muted transition-colors hover:border-border-bright hover:text-text"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                <path d="M13.73 21a2 2 0 0 1-3.46 0" />
              </svg>
              <span id="notif-badge" class="absolute -right-1 -top-1 flex h-4 w-4 items-center justify-center rounded-full bg-error text-[9px] font-bold text-white">3</span>
            </button>
            <!-- Popover — animates open/closed -->
            <div id="notif-popover" class="absolute right-0 top-full z-30 mt-2 hidden w-64 origin-top-right scale-95 rounded-lg border border-border bg-bg-muted opacity-0 shadow-xl transition-all duration-200">
              <div class="border-b border-border px-3 py-2">
                <span class="text-xs font-semibold text-text-heading">Notifications</span>
              </div>
              <div class="divide-y divide-border/50">
                <div class="flex items-start gap-2.5 px-3 py-2.5">
                  <span class="mt-0.5 h-2 w-2 shrink-0 rounded-full bg-pointgrab-blue"></span>
                  <div>
                    <p class="text-xs text-text">New order <span class="text-text-faint">#1847</span> received</p>
                    <p class="mt-0.5 text-[10px] text-text-faint">2 min ago</p>
                  </div>
                </div>
                <div class="flex items-start gap-2.5 px-3 py-2.5">
                  <span class="mt-0.5 h-2 w-2 shrink-0 rounded-full bg-amber"></span>
                  <div>
                    <p class="text-xs text-text">Inventory low on <span class="text-text-faint">SKU-2291</span></p>
                    <p class="mt-0.5 text-[10px] text-text-faint">18 min ago</p>
                  </div>
                </div>
                <div class="flex items-start gap-2.5 px-3 py-2.5">
                  <span class="mt-0.5 h-2 w-2 shrink-0 rounded-full bg-success"></span>
                  <div>
                    <p class="text-xs text-text">Deployment <span class="text-text-faint">v2.4.1</span> succeeded</p>
                    <p class="mt-0.5 text-[10px] text-text-faint">1 hr ago</p>
                  </div>
                </div>
              </div>
              <div class="border-t border-border px-3 py-2 text-center">
                <button class="text-[10px] font-medium text-pointgrab-blue hover:underline">View all</button>
              </div>
            </div>
          </div>
          <div class="h-8 w-8 rounded-full bg-gradient-to-br from-pointgrab-blue to-[#a78bfa]"></div>
        </div>
      </div>

      <!-- Stats row with animated progress -->
      <div class="mb-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
        <div class="rounded-lg border border-border bg-bg-muted p-3">
          <div class="text-[10px] font-medium uppercase tracking-wider text-text-faint">Revenue</div>
          <div class="mt-1 text-lg font-bold text-text-heading">$12,847</div>
          <div class="mt-1 text-[10px] text-success">+14.2%</div>
        </div>
        <div class="rounded-lg border border-border bg-bg-muted p-3">
          <div class="text-[10px] font-medium uppercase tracking-wider text-text-faint">Orders</div>
          <div class="mt-1 text-lg font-bold text-text-heading">284</div>
          <div class="mt-1 text-[10px] text-success">+8.1%</div>
        </div>
        <div class="rounded-lg border border-border bg-bg-muted p-3">
          <div class="text-[10px] font-medium uppercase tracking-wider text-text-faint">Fulfillment</div>
          <!-- Animated progress bar -->
          <div class="mt-2 h-2 overflow-hidden rounded-full bg-bg-raised">
            <div id="progress-bar" class="h-full rounded-full bg-pointgrab-blue transition-all duration-1000 ease-in-out" style="width: 0%"></div>
          </div>
          <div class="mt-1 flex items-center justify-between">
            <span id="progress-label" class="text-[10px] text-text-faint">0%</span>
            <span class="text-[10px] text-text-faint">target: 95%</span>
          </div>
        </div>
        <div class="rounded-lg border border-border bg-bg-muted p-3">
          <div class="text-[10px] font-medium uppercase tracking-wider text-text-faint">Processing</div>
          <!-- Loading skeleton animation -->
          <div id="skeleton-container" class="mt-2 space-y-1.5">
            <div class="h-2.5 w-full animate-pulse rounded bg-bg-raised"></div>
            <div class="h-2.5 w-3/4 animate-pulse rounded bg-bg-raised"></div>
          </div>
          <!-- Loaded state (hidden initially) -->
          <div id="skeleton-loaded" class="mt-1 hidden">
            <div class="text-lg font-bold text-text-heading">12</div>
            <div class="text-[10px] text-amber">in queue</div>
          </div>
        </div>
      </div>

      <!-- Table with live-updating row -->
      <div class="overflow-hidden rounded-lg border border-border">
        <div class="flex items-center justify-between border-b border-border bg-bg-muted px-4 py-2">
          <span class="text-xs font-semibold text-text-heading">Recent Orders</span>
          <button class="rounded-md bg-pointgrab-blue px-2.5 py-1 text-[10px] font-medium text-white transition-colors hover:bg-pointgrab-blue-bright">
            + New Order
          </button>
        </div>
        <table class="w-full text-left text-xs">
          <thead>
            <tr class="border-b border-border/50 text-text-faint">
              <th class="px-4 py-2 font-medium">Order</th>
              <th class="px-4 py-2 font-medium">Customer</th>
              <th class="hidden px-4 py-2 font-medium sm:table-cell">Amount</th>
              <th class="px-4 py-2 font-medium">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border/30">
            <tr class="transition-colors hover:bg-bg-muted/50">
              <td class="px-4 py-2.5 font-mono text-text-muted">#1847</td>
              <td class="px-4 py-2.5 text-text">Sarah Chen</td>
              <td class="hidden px-4 py-2.5 text-text-muted sm:table-cell">$249.00</td>
              <td class="px-4 py-2.5">
                <span class="inline-flex items-center gap-1 rounded-full bg-amber/10 px-2 py-0.5 text-[10px] font-medium text-amber">
                  <span class="h-1 w-1 rounded-full bg-amber"></span>
                  Processing
                </span>
              </td>
            </tr>
            <tr class="transition-colors hover:bg-bg-muted/50">
              <td class="px-4 py-2.5 font-mono text-text-muted">#1846</td>
              <td class="px-4 py-2.5 text-text">Mike Johnson</td>
              <td class="hidden px-4 py-2.5 text-text-muted sm:table-cell">$89.50</td>
              <td class="px-4 py-2.5">
                <span class="inline-flex items-center gap-1 rounded-full bg-success/10 px-2 py-0.5 text-[10px] font-medium text-success">
                  <span class="h-1 w-1 rounded-full bg-success"></span>
                  Shipped
                </span>
              </td>
            </tr>
            <!-- Animating row — flickers between states -->
            <tr id="live-row" class="transition-colors hover:bg-bg-muted/50">
              <td class="px-4 py-2.5 font-mono text-text-muted">#1845</td>
              <td class="px-4 py-2.5 text-text">Alex Rivera</td>
              <td class="hidden px-4 py-2.5 text-text-muted sm:table-cell">$412.00</td>
              <td class="px-4 py-2.5">
                <span id="live-status" class="inline-flex items-center gap-1 rounded-full bg-pointgrab-blue/10 px-2 py-0.5 text-[10px] font-medium text-pointgrab-blue transition-all duration-300">
                  <span class="h-1 w-1 animate-pulse rounded-full bg-pointgrab-blue"></span>
                  <span id="live-status-text">Syncing...</span>
                </span>
              </td>
            </tr>
            <tr class="transition-colors hover:bg-bg-muted/50">
              <td class="px-4 py-2.5 font-mono text-text-muted">#1844</td>
              <td class="px-4 py-2.5 text-text">Priya Patel</td>
              <td class="hidden px-4 py-2.5 text-text-muted sm:table-cell">$175.25</td>
              <td class="px-4 py-2.5">
                <span class="inline-flex items-center gap-1 rounded-full bg-success/10 px-2 py-0.5 text-[10px] font-medium text-success">
                  <span class="h-1 w-1 rounded-full bg-success"></span>
                  Delivered
                </span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Freeze mode hint badge — overlays bottom-left -->
      <div id="freeze-hint" class="absolute bottom-3 left-3 z-20 flex items-center gap-2 rounded-lg border border-border/50 bg-bg/90 px-3 py-1.5 opacity-0 backdrop-blur-sm transition-opacity duration-500 sm:bottom-4 sm:left-4">
        <kbd class="rounded border border-border bg-bg-muted px-1.5 py-0.5 font-mono text-[10px] text-text-muted">F</kbd>
        <span class="text-[10px] text-text-faint">Freeze animations to inspect moving elements</span>
      </div>
    </div>

    <!-- Output panel — shows real pointgrab clipboard output -->
    <div id="demo-output" class="border-t border-border bg-bg-muted transition-all duration-300" style="max-height: 0; overflow: hidden;">
      <div class="flex items-center justify-between border-b border-border/50 px-4 py-2">
        <div class="flex items-center gap-2 text-xs text-text-faint">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span>pointgrab output</span>
        </div>
        <span class="rounded border border-border px-2 py-0.5 text-[10px] text-text-faint">clipboard</span>
      </div>
      <pre id="demo-output-code" class="overflow-x-auto p-4 text-xs leading-relaxed sm:text-sm"></pre>
    </div>
  </div>

  <!-- Instructions -->
  <div class="mt-6 flex flex-col items-center gap-2 text-center">
    <p class="text-sm text-text-faint">
      <span class="hidden sm:inline">Hold <kbd class="rounded border border-border bg-bg-muted px-1.5 py-0.5 font-mono text-[10px] text-text-muted">&#8984;C</kbd> (Mac) or <kbd class="rounded border border-border bg-bg-muted px-1.5 py-0.5 font-mono text-[10px] text-text-muted">Ctrl+C</kbd> (Win) and hover, then click to capture. Or use the toolbar below.</span>
      <span class="sm:hidden">Use the toolbar to enter grab mode, then tap any element to inspect it.</span>
    </p>
    <p class="text-xs text-text-faint/70">
      Try the <kbd class="rounded border border-border bg-bg-muted px-1 py-0.5 font-mono text-[10px] text-text-muted">freeze</kbd> button on the toolbar to pause animations, then inspect the progress bar or syncing row.
    </p>
  </div>
</div>

<!-- Load the real pointgrab from npm -->
<script is:inline src="https://unpkg.com/pointgrab@0.1.1/dist/index.global.js"></script>

<script is:inline>
(function () {
  // --- Animations ---

  // Progress bar: loops 0% → 87% → reset
  var progressBar = document.getElementById('progress-bar');
  var progressLabel = document.getElementById('progress-label');
  var progressValue = 0;
  var progressDirection = 1;

  function tickProgress() {
    if (!progressBar || !progressLabel) return;
    progressValue += progressDirection * (2 + Math.random() * 3);
    if (progressValue >= 87) { progressValue = 87; progressDirection = 0; }
    // Reset after pause at top
    if (progressDirection === 0) {
      setTimeout(function () {
        progressValue = 0;
        progressDirection = 1;
        progressBar.style.width = '0%';
        progressLabel.textContent = '0%';
      }, 2000);
      progressDirection = -1; // mark as pausing
    }
    if (progressDirection === 1) {
      progressBar.style.width = Math.round(progressValue) + '%';
      progressLabel.textContent = Math.round(progressValue) + '%';
    }
  }
  setInterval(tickProgress, 400);

  // Skeleton loader: flips between loading and loaded every 4s
  var skeletonContainer = document.getElementById('skeleton-container');
  var skeletonLoaded = document.getElementById('skeleton-loaded');
  var skeletonVisible = true;

  setInterval(function () {
    if (!skeletonContainer || !skeletonLoaded) return;
    skeletonVisible = !skeletonVisible;
    if (skeletonVisible) {
      skeletonContainer.classList.remove('hidden');
      skeletonLoaded.classList.add('hidden');
    } else {
      skeletonContainer.classList.add('hidden');
      skeletonLoaded.classList.remove('hidden');
    }
  }, 4000);

  // Live status row: cycles through states
  var liveStatusText = document.getElementById('live-status-text');
  var liveStatus = document.getElementById('live-status');
  var statusStates = [
    { text: 'Syncing...', bg: 'bg-pointgrab-blue/10', fg: 'text-pointgrab-blue', dot: 'bg-pointgrab-blue' },
    { text: 'Validating', bg: 'bg-amber/10', fg: 'text-amber', dot: 'bg-amber' },
    { text: 'Confirmed', bg: 'bg-success/10', fg: 'text-success', dot: 'bg-success' },
    { text: 'Syncing...', bg: 'bg-pointgrab-blue/10', fg: 'text-pointgrab-blue', dot: 'bg-pointgrab-blue' },
  ];
  var statusIndex = 0;
  var allStatusBgs = ['bg-pointgrab-blue/10', 'bg-amber/10', 'bg-success/10'];
  var allStatusFgs = ['text-pointgrab-blue', 'text-amber', 'text-success'];
  var allDotColors = ['bg-pointgrab-blue', 'bg-amber', 'bg-success'];

  setInterval(function () {
    if (!liveStatusText || !liveStatus) return;
    statusIndex = (statusIndex + 1) % statusStates.length;
    var s = statusStates[statusIndex];
    liveStatusText.textContent = s.text;

    // Remove all, add current
    allStatusBgs.forEach(function (c) { liveStatus.classList.remove(c); });
    allStatusFgs.forEach(function (c) { liveStatus.classList.remove(c); });
    liveStatus.classList.add(s.bg, s.fg);

    var dot = liveStatus.querySelector('span');
    if (dot) {
      allDotColors.forEach(function (c) { dot.classList.remove(c); });
      dot.classList.add(s.dot);
    }
  }, 2500);

  // Notification popover toggle
  var notifBell = document.getElementById('notif-bell');
  var notifPopover = document.getElementById('notif-popover');

  if (notifBell && notifPopover) {
    notifBell.addEventListener('click', function (e) {
      e.stopPropagation();
      var isHidden = notifPopover.classList.contains('hidden');
      if (isHidden) {
        notifPopover.classList.remove('hidden');
        requestAnimationFrame(function () {
          notifPopover.classList.remove('scale-95', 'opacity-0');
          notifPopover.classList.add('scale-100', 'opacity-100');
        });
      } else {
        notifPopover.classList.add('scale-95', 'opacity-0');
        notifPopover.classList.remove('scale-100', 'opacity-100');
        setTimeout(function () { notifPopover.classList.add('hidden'); }, 200);
      }
    });

    document.addEventListener('click', function () {
      if (!notifPopover.classList.contains('hidden')) {
        notifPopover.classList.add('scale-95', 'opacity-0');
        notifPopover.classList.remove('scale-100', 'opacity-100');
        setTimeout(function () { notifPopover.classList.add('hidden'); }, 200);
      }
    });
  }

  // Show freeze hint after a few seconds
  var freezeHint = document.getElementById('freeze-hint');
  if (freezeHint) {
    setTimeout(function () {
      freezeHint.style.opacity = '1';
    }, 3000);
  }

  // --- Initialize real pointgrab ---

  var output = document.getElementById('demo-output');
  var outputCode = document.getElementById('demo-output-code');

  if (typeof PointGrab !== 'undefined' && output && outputCode) {
    var pg = PointGrab.init({
      activationMode: 'hold',
      showToolbar: true,
      enabled: true,
      devOnly: false,
    });

    // Show toolbar immediately so visitors can interact with it
    pg.showToolbar();

    pg.registerPlugin({
      name: 'demo-output',
      hooks: {
        onCopySuccess: function (context) {
          // Format the context nicely for display
          var html = '';
          if (context.html) {
            html += escapeAndHighlight(context.html);
          }
          if (context.componentName) {
            html += '\n\n<span class="text-zinc-400">Component:</span> <span class="text-purple-400">' + esc(context.componentName) + '</span>';
          }
          if (context.filePath) {
            html += '\n<span class="text-zinc-400">Source:</span>    <span class="text-zinc-200">' + esc(context.filePath) + '</span>';
            if (context.line) html += '<span class="text-zinc-500">:</span><span class="text-amber-400">' + context.line + '</span>';
          }
          if (context.selector) {
            html += '\n<span class="text-zinc-400">Selector:</span>  <span class="text-green-400">' + esc(context.selector) + '</span>';
          }
          if (context.componentStack && context.componentStack.length > 1) {
            html += '\n\n<span class="text-zinc-500">--- component stack ---</span>';
            context.componentStack.forEach(function (entry) {
              html += '\n<span class="text-purple-400">' + esc(entry.name) + '</span>';
              if (entry.filePath) {
                html += ' <span class="text-zinc-400">at</span> <span class="text-zinc-300">' + esc(entry.filePath) + '</span>';
              }
            });
          }

          outputCode.innerHTML = html;
          output.style.maxHeight = '260px';
          output.style.overflow = 'auto';
        },
      },
    });
  }

  function esc(str) {
    var div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  function escapeAndHighlight(rawHtml) {
    var escaped = esc(rawHtml);
    // Highlight tags
    escaped = escaped.replace(/&lt;(\/?)([\w-]+)/g, '<span class="text-zinc-500">&lt;$1</span><span class="text-blue-400">$2</span>');
    escaped = escaped.replace(/&gt;/g, '<span class="text-zinc-500">&gt;</span>');
    // Highlight attributes
    escaped = escaped.replace(/ ([\w-]+)=/g, ' <span class="text-amber-400">$1</span>=');
    // Highlight strings
    escaped = escaped.replace(/&quot;([^&]*)&quot;/g, '<span class="text-green-400">"$1"</span>');
    return escaped;
  }
})();
</script>
